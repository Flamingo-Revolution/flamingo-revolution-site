---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../data/site";

interface Props {
  currentLocale: Locale;
}

const { currentLocale } = Astro.props;

const locales = [
  { code: "sq", label: "Shqip", href: getRelativeLocaleUrl("sq", "") },
  { code: "en", label: "English", href: getRelativeLocaleUrl("en", "") }
] as const;
---

<nav class="locale-switch" aria-label="Languages">
  {
    locales.map((locale) => (
      <a
        href={locale.href}
        class:list={[
          "locale-switch__link",
          locale.code === currentLocale && "locale-switch__link--active"
        ]}
        aria-current={locale.code === currentLocale ? "page" : undefined}
      >
        {locale.label}
      </a>
    ))
  }
</nav>
