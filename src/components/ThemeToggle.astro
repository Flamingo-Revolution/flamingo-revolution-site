---
interface Props {
  labels: {
    button: string;
    light: string;
    dark: string;
  };
}

const { labels } = Astro.props;
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-label-light={labels.light}
  data-label-dark={labels.dark}
  aria-label={labels.button}
  title={labels.button}
  aria-pressed="false"
>
  <span class="theme-toggle__icon" aria-hidden="true">
    <svg class="theme-toggle__icon-sun" viewBox="0 0 24 24">
      <circle cx="12" cy="12" r="4.6" fill="currentColor" />
      <g stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <path d="M12 2.5v2.6M12 18.9v2.6M4.2 12H1.6M22.4 12h-2.6M5.4 5.4l1.8 1.8M16.8 16.8l1.8 1.8M18.6 5.4l-1.8 1.8M7.2 16.8l-1.8 1.8" />
      </g>
    </svg>
    <svg class="theme-toggle__icon-moon" viewBox="0 0 24 24">
      <path fill="currentColor" d="M20.6 14.7A8.6 8.6 0 1 1 9.3 3.4a7 7 0 1 0 11.3 11.3Z" />
    </svg>
  </span>
</button>
