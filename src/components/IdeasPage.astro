---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "./SiteHeader.astro";
import IdeasSection from "./IdeasSection/IdeasSection.svelte";
import type { Locale, SiteCopy } from "../data/site";
import { ideasPageCopy } from "../data/ideas";

interface Props {
  locale: Locale;
  siteCopy: SiteCopy;
}

const { locale, siteCopy } = Astro.props;
const copy = ideasPageCopy[locale];
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale}>
  <div class="page-shell">
    <SiteHeader locale={locale} copy={siteCopy} currentPage="ideas" localePath="idete-tuaja" />

    <main class="ideas-page" id="main" tabindex="-1">
      <section class="ideas-hero">
        <div>
          <p class="eyebrow">{copy.kicker}</p>
          <h1>
            {copy.title.map((word) => <span>{word}</span>)}
          </h1>
          <p class="lead">{copy.description}</p>
          <div class="hero__actions">
            <a class="button button--primary" href="#ideas-compose-input">
              {copy.formLabel}
            </a>
          </div>
        </div>

        <div class="ideas-hero__panel">
          <h2>{copy.panelTitle}</h2>
          <p>{copy.panelText}</p>
          <strong>{siteCopy.brand.name}</strong>
        </div>
      </section>

      <IdeasSection client:only="svelte" {copy} />
    </main>

    <footer class="footer-note">
      <p>{siteCopy.footer.text}</p>
      <nav class="footer-links" aria-label="Social links">
        {
          siteCopy.footer.links.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label}
            </a>
          ))
        }
      </nav>
    </footer>
  </div>
</BaseLayout>
