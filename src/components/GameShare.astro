---
import { gameShareLinks } from '../lib/gameShare';
import SocialIcon from './SocialIcon.astro';

interface Props {
	title: string;
	path: string;
	compact?: boolean;
}

const { title, path, compact = false } = Astro.props;
if (!Astro.site) throw new Error('Game sharing requires the configured public site URL.');
const url = new URL(path, Astro.site).href;
const links = gameShareLinks(url, title);
const id = `share-${path.split(/[\/#]/).filter(Boolean).join('-')}`;
---

<game-share data-url={url} data-title={title}>
	<details class:list={['game-share', { 'game-share--compact': compact }]}>
		<summary aria-controls={id} aria-label={`Shpërnda: ${title}`} title={`Shpërnda: ${title}`}>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
				<path d="m8.6 10.5 6.8-4M8.6 13.5l6.8 4" />
			</svg>
			{!compact && <>
				Shpërnda
				<svg class="share-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
			</>}
		</summary>
		<div class="share-panel" id={id}>
			<div class="share-heading">
				<strong>{title}</strong>
				<button type="button" class="share-close" aria-label="Mbyll shpërndarjen" data-close>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
				</button>
			</div>
			<ul aria-label={`Mënyrat e shpërndarjes për ${title}`}>
				<li class="share-copy-row"><button type="button" data-copy>
					<svg class="share-option-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2" /><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1" /></svg>
					<span>Kopjo linkun</span>
				</button></li>
				<li><a href={links.facebook} target="_blank" rel="noopener noreferrer"><span class="share-brand-icon"><SocialIcon label="Facebook" /></span><span>Facebook</span></a></li>
				<li><button type="button" data-discord><span class="share-brand-icon"><SocialIcon label="Discord" /></span><span>Discord</span></button></li>
				<li><a href={links.whatsapp} target="_blank" rel="noopener noreferrer"><span class="share-brand-icon"><SocialIcon label="WhatsApp" /></span><span>WhatsApp</span></a></li>
				<li><a href={links.x} target="_blank" rel="noopener noreferrer"><span class="share-brand-icon"><SocialIcon label="X" /></span><span>X</span></a></li>
			</ul>
			<p class="share-status" role="status" aria-live="polite" aria-atomic="true"></p>
			<label class="share-manual" hidden>
				Linku i lojës — kopjoje manualisht:
				<input type="text" readonly value={url} aria-label="Linku i lojës" />
			</label>
			<a class="discord-link" href="https://discord.com/channels/@me" target="_blank" rel="noopener noreferrer" hidden>Hap Discord <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
		</div>
	</details>
</game-share>

<script>
	import { copyGameLink, shareGameToDiscord, sharePanelLayout } from '../lib/gameShare';

	class GameShareElement extends HTMLElement {
		private controller?: AbortController;

		connectedCallback() {
			if (this.controller) return;
			this.controller = new AbortController();
			const { signal } = this.controller;
			const details = this.querySelector('details')!;
			const trigger = this.querySelector('summary')!;
			const panel = this.querySelector<HTMLElement>('.share-panel')!;
			const status = this.querySelector<HTMLElement>('.share-status')!;
			const manual = this.querySelector<HTMLLabelElement>('.share-manual')!;
			const input = manual.querySelector('input')!;
			const discordLink = this.querySelector<HTMLAnchorElement>('.discord-link')!;
			const url = this.dataset.url!;
			let busy = false;
			const positionPanel = () => {
				if (!details.open) return;
				const { top, bottom } = trigger.getBoundingClientRect();
				const { side, space } = sharePanelLayout(top, bottom, window.innerHeight);
				panel.dataset.side = side;
				panel.style.setProperty('--share-space', `${space}px`);
			};

			const close = (restoreFocus = false) => {
				details.open = false;
				if (restoreFocus) trigger.focus();
			};
			const showManualCopy = () => {
				manual.hidden = false;
				input.focus();
				input.select();
			};

			details.addEventListener('toggle', () => {
				if (!details.open) return;
				document.querySelectorAll<HTMLDetailsElement>('game-share details[open]').forEach((other) => {
					if (other !== details) other.open = false;
				});
				status.textContent = '';
				manual.hidden = true;
				discordLink.hidden = true;
				positionPanel();
			}, { signal });
			window.addEventListener('resize', positionPanel, { signal });
			window.addEventListener('scroll', positionPanel, { signal, passive: true });
			this.querySelector('[data-close]')!.addEventListener('click', () => close(true), { signal });
			document.addEventListener('pointerdown', (event) => {
				if (event.target instanceof Node && !this.contains(event.target)) close();
			}, { signal });
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && details.open) {
					event.preventDefault();
					close(true);
				}
			}, { signal });
			this.addEventListener('focusout', (event) => {
				if (event.relatedTarget instanceof Node && !this.contains(event.relatedTarget)) close();
			}, { signal });

			this.querySelector('[data-copy]')!.addEventListener('click', async () => {
				if (busy) return;
				busy = true;
				manual.hidden = true;
				discordLink.hidden = true;
				const copied = await copyGameLink(url, navigator);
				busy = false;
				if (!this.isConnected || !details.open) return;
				status.textContent = copied ? 'Linku u kopjua!' : 'Kopjimi automatik nuk u lejua. Kopjo linkun më poshtë.';
				if (!copied) showManualCopy();
			}, { signal });

			this.querySelector('[data-discord]')!.addEventListener('click', async () => {
				if (busy) return;
				busy = true;
				manual.hidden = true;
				discordLink.hidden = true;
				status.textContent = '';
				const { copied, opened } = await shareGameToDiscord(url, navigator, () => window.open('about:blank', '_blank'));
				busy = false;
				if (!this.isConnected || !details.open) return;
				discordLink.hidden = opened;
				status.textContent = opened
					? 'Linku u kopjua! Ngjite në bisedën që dëshiron në Discord.'
					: copied
						? 'Linku u kopjua! Nëse Discord nuk u hap, përdor linkun më poshtë.'
						: 'Kopjo linkun më poshtë, pastaj hape Discord dhe ngjite në bisedë.';
				if (!copied) showManualCopy();
			}, { signal });
		}

		disconnectedCallback() {
			this.controller?.abort();
			this.controller = undefined;
		}
	}

	if (!customElements.get('game-share')) customElements.define('game-share', GameShareElement);
</script>

<style>
	game-share { display: block; max-width: 100%; }
	.game-share { position: relative; }
	summary { display: flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 3.2rem; padding: 0.8rem 1rem; border: 1px solid var(--ink); border-radius: 0.5rem; background: var(--surface); color: var(--text); font-weight: 700; list-style: none; cursor: pointer; }
	summary::-webkit-details-marker { display: none; }
	.game-share--compact > summary { width: 2.75rem; min-height: 2.75rem; padding: 0.7rem; }
	summary svg { width: 1.1rem; height: 1.1rem; }
	summary .share-chevron { width: 0.9rem; height: 0.9rem; margin-left: 0.15rem; }
	details[open] .share-chevron { transform: rotate(180deg); }
	summary:hover, details[open] > summary { background: var(--accent-soft); }
	summary:focus-visible, .share-panel :is(a, button, input):focus-visible { outline: 3px solid var(--accent-strong); outline-offset: 3px; }
	.share-panel { position: absolute; z-index: 10; right: 0; bottom: calc(100% + 0.8rem); width: min(17rem, calc(100vw - 4rem)); max-height: min(34rem, var(--share-space, 70dvh)); overflow-y: auto; padding: 0.5rem; border: 1px solid color-mix(in srgb, var(--ink) 20%, transparent); border-radius: 0.75rem; background: var(--surface); box-shadow: 0 8px 28px rgb(0 0 0 / 20%); color: var(--text); }
	.share-panel[data-side='below'] { top: calc(100% + 0.8rem); bottom: auto; }
	.share-heading { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0 0 0.4rem 0.6rem; border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); }
	.share-heading strong { color: var(--muted); font-size: 0.8rem; font-weight: 600; line-height: 1.4; }
	.share-panel button { font: inherit; cursor: pointer; }
	.share-close { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.75rem; border: 0; border-radius: 0.4rem; background: transparent; color: var(--muted); }
	.share-close:hover { background: var(--paper-cool); color: var(--text); }
	.share-close svg { width: 1rem; height: 1rem; }
	.share-panel ul { display: grid; gap: 0.25rem; margin: 0.5rem 0 0; padding: 0; list-style: none; }
	.share-panel li :is(a, button) { display: flex; align-items: center; gap: 0.8rem; width: 100%; min-height: 2.75rem; padding: 0.65rem 0.7rem; border: 0; border-radius: 0.4rem; background: transparent; color: var(--text); font-size: 0.9rem; font-weight: 600; text-align: left; text-decoration: none; }
	.share-panel li :is(a, button):hover { background: var(--accent-soft); }
	.share-brand-icon, .share-option-icon { display: inline-flex; flex: 0 0 1.2rem; width: 1.2rem; height: 1.2rem; }
	.share-brand-icon :global(svg) { display: block; width: 100%; height: 100%; fill: currentColor; }
	.share-copy-row { margin-bottom: 0.25rem; padding-bottom: 0.45rem; border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent); }
	.share-status, .share-manual { margin: 0.75rem 0 0; font-size: 0.8rem; line-height: 1.5; }
	.share-status:empty { display: none; }
	.share-manual input { width: 100%; min-height: 2.75rem; margin-top: 0.3rem; padding: 0.4rem; border: 1px solid var(--ink); background: var(--paper-cool); color: var(--text); font: inherit; }
	.discord-link { margin-top: 0.75rem; color: var(--text); font-size: 0.85rem; font-weight: 800; text-decoration: underline; }
	.discord-link:not([hidden]) { display: inline-flex; align-items: center; gap: 0.4rem; }
	.discord-link svg { width: 1rem; height: 1rem; }
	[hidden] { display: none !important; }
</style>
