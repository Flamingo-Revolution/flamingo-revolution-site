---
import type { Locale, SiteCopy } from "../data/site";
import SocialIcon from "./SocialIcon.astro";

interface Props {
	locale: Locale;
	copy: SiteCopy;
}

type FooterLink = {
	href: string;
	label: string;
};

type FooterSection = {
	title: string;
	links: FooterLink[];
};

const { locale, copy } = Astro.props;
const prefix = locale === "sq" ? "" : "/en";
const homeHref = locale === "sq" ? "/" : "/en/";
const linksLabel = locale === "sq" ? "Rrjetet sociale" : "Social links";
const footerLabel = locale === "sq" ? "Lidhje në fund të faqes" : "Footer links";
const legalLabel = locale === "sq" ? "Informacion ligjor dhe redaksional" : "Legal and editorial information";
const email = "info@flamingorevolution.eu";
const githubHref = "https://github.com/Flamingo-Revolution";
const currentYear = new Date().getFullYear();

const footerSections: FooterSection[] =
	locale === "sq"
		? [
				{
					title: "Projektet",
					links: [
						{ href: `${prefix}/idete-tuaja/`, label: "Idetë tuaja" },
						{ href: `${prefix}/projektligje/`, label: "Projektligjet" },
						{ href: `${prefix}/flamingo-times/`, label: "Flamingo Times" },
						{ href: `${prefix}/dosjet/`, label: "Flamingo Dossier" },
						{ href: `${prefix}/news/`, label: "Flamingo News" },
						{ href: `${prefix}/harta/`, label: "Harta e protestave" },
						{ href: `${prefix}/pulsi-protestes/`, label: "Pulsi i protestës" }
					]
				},
				{
					title: "Referendumi",
					links: [
						{ href: `${prefix}/referendum/`, label: "Referendumi 21/2024" },
						{ href: `${prefix}/referendum/pse-referendum/`, label: "Pse referendum?" },
						{ href: `${prefix}/referendum/si-nisi/`, label: "Si nisi nisma?" },
						{ href: `${prefix}/referendum/pyetje-te-shpeshta/`, label: "Pyetje të shpeshta" },
						{ href: `${prefix}/referendum/#njoftime`, label: "Merr njoftime" }
					]
				},
				{
					title: "Rreth nesh",
					links: [
						{ href: `${prefix}/rreth-nesh/`, label: "Kush jemi" },
						{ href: `${prefix}/protestat/`, label: "Protestat" },
						{ href: `${prefix}/rreth-nesh/#kontakt`, label: "Kontakt" },
						{ href: `${prefix}/redaksia/`, label: "Redaksia" }
					]
				}
			]
		: [
				{
					title: "Projects",
					links: [
						{ href: `${prefix}/idete-tuaja/`, label: "Your ideas" },
						{ href: `${prefix}/projektligje/`, label: "Draft laws" },
						{ href: `${prefix}/flamingo-times/`, label: "Flamingo Times" },
						{ href: `${prefix}/dosjet/`, label: "Flamingo Dossier" },
						{ href: `${prefix}/news/`, label: "Flamingo News" },
						{ href: `${prefix}/map/`, label: "Protest map" },
						{ href: `${prefix}/pulse/`, label: "Protest pulse" }
					]
				},
				{
					title: "Referendum",
					links: [
						{ href: `${prefix}/referendum/`, label: "Referendum 21/2024" },
						{ href: `${prefix}/referendum/pse-referendum/`, label: "Why a referendum?" },
						{ href: `${prefix}/referendum/si-nisi/`, label: "How it started" },
						{ href: `${prefix}/referendum/pyetje-te-shpeshta/`, label: "Frequently asked questions" },
						{ href: `${prefix}/referendum/#njoftime`, label: "Get updates" }
					]
				},
				{
					title: "About us",
					links: [
						{ href: `${prefix}/rreth-nesh/`, label: "Who we are" },
						{ href: `${prefix}/protestat/`, label: "Protests" },
						{ href: `${prefix}/rreth-nesh/#kontakt`, label: "Contact" },
						{ href: `${prefix}/redaksia/`, label: "Editorial policy" }
					]
				}
			];

const legalLinks: FooterLink[] =
	locale === "sq"
		? [{ href: `${prefix}/privatesia/`, label: "Privatësia" }]
		: [{ href: `${prefix}/privatesia/`, label: "Privacy" }];
---

<footer class="footer-note">
	<div class="footer-note__main">
		<div class="footer-note__brand">
			<a class="footer-note__brand-logo" href={homeHref} aria-label={copy.brand.name}>
				<img
					class="footer-note__logo footer-note__logo--theme-light"
					src="/images/flamingo-wordmark-dark.svg"
					alt=""
					width="426"
					height="187"
					aria-hidden="true"
				/>
				<img
					class="footer-note__logo footer-note__logo--theme-dark"
					src="/images/flamingo-wordmark-light.svg"
					alt=""
					width="419"
					height="187"
					aria-hidden="true"
				/>
			</a>
			<p>{copy.footer.text}</p>
			<a class="footer-note__email" href={`mailto:${email}`}>{email}</a>
		</div>

		<nav class="footer-nav" aria-label={footerLabel}>
			{
				footerSections.map((section) => (
					<section class="footer-nav__section">
						<h2>{section.title}</h2>
						<ul>
							{section.links.map((link) => (
								<li><a href={link.href}>{link.label}</a></li>
							))}
						</ul>
					</section>
				))
			}
		</nav>
	</div>

	<div class="footer-note__bottom">
		<div class="footer-note__utility">
			<p class="footer-note__meta">© {currentYear} {copy.brand.name}</p>
			<nav class="footer-legal" aria-label={legalLabel}>
				{
					legalLinks.map((link) => (
						<a href={link.href}>{link.label}</a>
					))
				}
			</nav>
		</div>
		<nav class="footer-links" aria-label={linksLabel}>
			{
				copy.footer.links.map((link) => (
					<a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}>
						<SocialIcon label={link.label} />
					</a>
				))
			}
			<a href={githubHref} target="_blank" rel="noreferrer" aria-label="GitHub" title="GitHub">
				<SocialIcon label="GitHub" />
			</a>
		</nav>
	</div>
</footer>
