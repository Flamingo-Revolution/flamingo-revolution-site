---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  flamingoTimesIssues,
  isLatestIssue,
  issuePageTitle,
  issuePublishedDate
} from "../data/flamingoTimes";
import { siteCopy } from "../data/site";
import FlamingoTimesNav from "./FlamingoTimesNav.astro";
import SiteFrame from "./SiteFrame.astro";
import "../styles/flamingo-times.css";
import "../styles/flamingo-times-issue-six.css";
import "../styles/flamingo-times-issue-ten.css";

const copy = siteCopy.sq;
const pdfHref = "/documents/flamingo-times/flamingo-times-botimi-10.pdf";

interface Props {
  isLatest?: boolean;
}

const { isLatest = false } = Astro.props;
const issue = flamingoTimesIssues.find((entry) => entry.number === 10)!;
const canonicalPath = isLatest || isLatestIssue(issue) ? "/flamingo-times/" : undefined;
---

<BaseLayout
  title={issuePageTitle(issue)}
  description={issue.excerpt}
  locale="sq"
  pageType="NewsArticle"
  publishedTime={issuePublishedDate(issue)}
  canonicalPath={canonicalPath}
  socialImagePath={issue.imageSrc}
  socialImageAlt={issue.imageAlt}
  breadcrumbs={
    isLatest
      ? [
          { name: "Ballina", path: "/" },
          { name: "Flamingo Times", path: "/flamingo-times/" }
        ]
      : [
          { name: "Ballina", path: "/" },
          { name: "Flamingo Times", path: "/flamingo-times/" },
          { name: issue.title, path: issue.href }
        ]
  }
>
  <SiteFrame locale="sq" copy={copy} currentPage="times" shellClass="times-shell">
    <main class="times-page" id="main" tabindex="-1">
      <section class="times-masthead" aria-labelledby="times-title">
        <div class="times-masthead__meta">
          <span>Tiranë, Shtator 2026</span>
          <span>Botimi X</span>
        </div>
        <p class="times-masthead__kicker">Përgatitur nga flamingorevolution.eu</p>
        <h1 id="times-title">Flamingo <em>Times</em></h1>
        <div class="times-masthead__rule">
          <p>Shtypur në zyrat e shtetit nga nëpunës me ndërgjegje</p>
          <div class="times-masthead__actions">
            <a class="times-download" href={pdfHref} download>Shkarko botimin</a>
          </div>
        </div>
      </section>

      <FlamingoTimesNav current={isLatest ? "latest" : "archive"} />

      <nav class="times-sections" aria-label="Seksionet e gazetës">
        <a href="#kryeartikulli">Kryeartikulli</a>
        <a href="#tirana">Tirana</a>
        <a href="#vendimmarrja">Vendimmarrja</a>
        <a href="#arkitektet">Arkitektët</a>
        <a href="#kerkesat">5 kërkesat</a>
      </nav>

      <article class="times-government times-ten" id="kryeartikulli">
        <header class="times-government__hero times-ten__hero">
          <p class="times-label">Qyteti dhe pushteti</p>
          <h2>Arkitektura nuk është imazh</h2>
          <p class="times-deck">
            Një fasadë mund ta kuptosh nga fotografia. Për të kuptuar një qytet, duhet të zbresësh
            në rrugë.
          </p>
          <p class="times-ten__citation">
            Koment i intervistës së Edi Ramës për revistën Domus, qershor 2026: “Arkitektura nuk
            është arkitekturë, është imazh”. Pasazhet e intervistës janë përshtatur gjuhësisht.
          </p>
        </header>

        <section class="times-ten__lead" aria-label="Hyrja e kryeartikullit">
          <div class="times-ten__lead-copy">
            <p class="times-dropcap">
              Në intervistën e tij në revistën Domus, Edi Rama shprehet mbi fuqinë e arkitekturës
              për të gjeneruar zhvillim, për të influencuar mënyrën sesi jetojmë, por mbi të gjitha
              për nevojën për të qenë e rrënjosur në shpirtin e një vendi. Le të fokusohemi tek
              disa nga tezat që ai hedh:
            </p>
            <blockquote class="times-ten__quote">
              “Kur njerëzit përballen me një ndërtesë, që mund të jetë shumë e bukur, por që nuk
              lidhet me shqisat dhe përvojën e tyre, ata ndihen më të huaj sesa të integruar. Ata
              mendojnë se gjëra të tilla i bëjnë njerëzit e pasur, se kjo është një botë, që nuk u
              përket atyre. Në këtë rast, kur po këta njerëz krijojnë diçka, që lidhet me vendin
              dhe kontekstin, atëherë njerëzit e zakonshëm ndihen më të fuqizuar dhe më të
              përfshirë.”
            </blockquote>
            <p>
              Në vitet e fundit, imazhi urban i Tiranës ka ndryshuar shpesh. Ndërtesa të larta, që
              mund të jenë të bukura, janë ngritur në hapësira publike. Nuk është gjithmonë e qartë
              nëse brenda këtyre ndërtesave ka zyra a apartamente. Për shumicën e qytetarëve të
              Tiranës, ato formojnë sfondin kur ngelen në trafik në rrugët e ngushta të qytetit.
            </p>
          </div>

          <figure class="times-ten__feature times-ten__feature--hero">
            <img
              src="/images/flamingo-times/botimi-10/kullat.jpeg"
              alt="Alban Tower dhe ndërtesat përreth të fotografuara nga niveli i rrugës"
              width="800"
              height="600"
            />
            <figcaption>
              <strong>Alban Tower, nga niveli i rrugës.</strong> Në Tiranë, kullat e ndryshojnë
              horizontin, por a e përmirësojnë jetën poshtë tyre? Foto arkivi: James Clark / Nomadic
              Notes; botuar më 18 janar 2022.
            </figcaption>
          </figure>
        </section>

        <section class="times-ten__columns" id="tirana" aria-labelledby="tirana-title">
          <h3 id="tirana-title">Tirana përtej fasadës</h3>
          <p>
            Ndryshimi i Tiranës nuk përmblidhet në fotografitë e kullave. Më 2017, Sheshi
            Skënderbej u kthye në hapësirë për këmbësorët. Më 17 maj 2020, u shemb Teatri Kombëtar.
            Këshilli Bashkiak e mbështeti vendimin për shembjen në akt-ekspertizën e Institutit të
            Ndërtimit, ndërsa Aleanca për Mbrojtjen e Teatrit dhe Europa Nostra kërkonin ruajtjen
            dhe restaurimin e godinës. Këto janë ndryshime të përdorimit dhe të trashëgimisë së
            qytetit, jo thjesht ndryshime pamjeje.
          </p>

          <blockquote class="times-ten__statement">
            Kullat shihen nga larg.<br />Qyteti jetohet nga afër.
          </blockquote>

          <p>
            Ndërkohë, në përshkrimin e projektit të saj për transportin në Tiranë gjatë viteve
            2020 deri në 2024, GIZ evidentonte trafik të rënduar, ndikime serioze në cilësinë e
            ajrit dhe nevojën për përmirësimin e transportit publik, trotuareve dhe rrugëve për
            biçikleta. Këto probleme nuk shihen në një fotografi të fasadës.
          </p>
          <p>
            Prandaj, krahas pyetjes “Sa kate do të ketë?”, duhen edhe pyetje të tjera: “Çfarë ruhet
            nga qyteti, që kemi trashëguar?” “Sa hapësirë publike krijohet dhe sa humbet?” “Si
            lidhet ndërtesa me transportin, rrugën dhe lagjen?” “Çfarë kanë propozuar banorët dhe
            çfarë është ndryshuar pas mendimit të tyre?” Fasada tregon pamjen. Planet, të dhënat dhe
            përvoja e banorëve tregojnë pasojat.
          </p>
        </section>

        <blockquote class="times-ten__question" id="vendimmarrja">
          Kush e projekton qytetin?<br />Kush merr pjesë në vendim?
        </blockquote>

        <section class="times-ten__columns times-ten__columns--second" id="arkitektet" aria-label="Arkitektura dhe vendimmarrja">
          <figure class="times-ten__feature times-ten__feature--portrait">
            <img
              src="/images/flamingo-times/botimi-10/mjekerroshi-bardherosh.jpeg"
              alt="Ndërtesë shumëkatëshe me ballkone të rrumbullakosura"
              width="447"
              height="447"
            />
            <figcaption><strong>Mjekërroshi bardhërosh</strong> vendos kokën e vet në mes të qytetit.</figcaption>
          </figure>

          <p>
            Në botë, procese të përfshirjes së qytetarëve në hartimin e planeve urbanistike nuk
            janë të pazakonta; shpeshherë ato janë të detyrueshme. Për projektet, që ndryshojnë
            lagjet, pyetja është konkrete: “A u dëgjuan banorët përpara miratimit dhe çfarë ndryshoi
            në projekt pas mendimit të tyre?” Kjo na çon edhe te roli i arkitektëve vendas në këto
            zhvillime.
          </p>

          <h3>Çfarë mësohet në studiot e mëdha?</h3>
          <p>
            Të gjithë arkitektët ndërkombëtarë punojnë me studio vendase. Sot, Tirana konsiderohet
            qyteti me universitetin më të madh të hapur të arkitekturës. Arkitektët e rinj të këtij
            vendi po punojnë me disa nga arkitektët më të mëdhenj në botë.
          </p>
          <p>
            Sot, shumica e arkitektëve të njohur janë të pajisur me një shpurë dizenjuesish, të
            cilët deshifrojnë skicat e tyre dhe menaxhojnë projektet. Atmosfera në këto studio është
            gjithçka tjetër përveçse paqësore; puna është e lodhshme, stresuese dhe jopërmbushëse.
            Ballafaqimi me këtë realitet, mbi të gjitha kur në ndërgjegjen tonë kolektive arkitektë
            të famshëm të huaj janë parë si korifenj, është i dhimbshëm për një profesionist të ri.
            Së fundmi, fatmirësisht, në diskutimet akademike vihet re një ulje e figurës së
            “starkitektëve”, çka duket se përputhet dhe me një pikë tjetër, që ngrihet në intervistë.
          </p>

          <h3>Arkitektët vendas: çfarë roli kanë?</h3>
          <blockquote class="times-ten__quote">
            “Ka pasur kritika këtu lidhur me përfshirjen e arkitektëve ndërkombëtarë, ku njerëzit
            pyesin: ‘Po arkitektët vendas ku janë?’ Në rastet kur procesi bëhet kompleks, për të
            ndërtuar në një shkallë më të lartë, nevojiten njohuri dhe përvojë. Këto njohuri nuk
            mund të fitohen duke bërë gabime, sepse ato gabime mund të jenë shumë të rrezikshme.”
          </blockquote>
          <p>
            Për të ndërtuar në shkallë të madhe, nevojitet edhe kohë. Një zgjidhje e mirë
            arkitektonike dhe urbanistike arrihet si rezultat i një procesi të gjatë dizenjimi, ku
            projekti përmirësohet duke u parë nga kënde të ndryshme. Është e rrezikshme të mendohet
            se, në këtë proces diskutimi, vizioni i arkitektëve ndërkombëtarë është më i vlefshëm se
            ai i profesionistëve, që e njohin Shqipërinë, jetojnë aty, apo kanë një lidhje më të
            fortë me të. Qytetet perëndimore duken sikur funksionojnë në mënyrë perfekte, sepse janë
            zhvilluar ndër shekuj dhe vazhdojnë t’i lejojnë kohë vetes me çdo ndërhyrje që
            ndërmarrin.
          </p>

          <h3>Të ndërtosh më shumë apo të ndërhysh me më shumë kujdes?</h3>
          <blockquote class="times-ten__quote">
            “Ajo, që bie në sy dhe ndoshta është disi e dhimbshme, është se nëse dëshiron të shohësh
            arkitekturë të ndjekur me ambicie të vërtetë, shpesh duhet të shikosh përtej Europës,
            drejt Kinës, Lindjes së Mesme dhe konteksteve të tjera në zhvillim të shpejtë. Në
            Europë, kjo po bëhet gjithnjë e më e rrallë.”
          </blockquote>
          <p>
            Është e vërtetë se standardizimi dhe burokracia e kanë ngadalësuar zhvillimin urban në
            Europë, por nuk është vetëm kjo arsyeja për këtë stagnim. Shumica e qyteteve europiane
            kanë arritur një fazë pjekurie të fondit të ndërtimit, që mbështet një cilësi të lartë
            jetese dhe ku ndryshimi i këtij imazhi nuk paraqitet gjithmonë i nevojshëm. Përballë
            ngrohjes globale dhe problematikave mjedisore, diskutimi tashmë është zhvendosur drejt
            ndërtimit në mënyrë të qëndrueshme me materiale biologjike, duke ndërhyrë sa më pak në
            mjedisin e ndërtuar.
          </p>
          <p>
            Tashmë arkitektura nuk përfaqësohet më me imazhin e kullave të xhamit, që vazhdojnë të
            ndërtohen në Lindjen e Mesme. Ajo nuk është më një imazh, por përfaqësohet me ndërhyrje
            të matura, që nuk thërrasin për vëmendje e që, në fjalët e kryeministrit, mbështeten në
            njohjen e shpirtit të vendit.
          </p>
        </section>

        <blockquote class="times-ten__closing">
          Një qytet nuk ndërtohet vetëm për t’u parë.<br />Ndërtohet për t’u jetuar.
        </blockquote>

        <section class="times-six__demands" id="kerkesat">
          <header>
            <p class="times-label">Nga reagimi te organizimi</p>
            <h3>5 kërkesat që na bashkojnë</h3>
            <p class="times-six__demands-intro">
              Ndërkohë që shoqëria mëson të organizohet, protesta na bashkon me 5 kërkesat e saj:
            </p>
          </header>
          <ol>
            <li>Dorëheqjen e panegociueshme të Kryeministrit dhe të qeverisë.</li>
            <li>Krijimin e një qeverie teknike tranzitore, jopartiake, me mandat 12-mujor.</li>
            <li>
              Ndryshime kushtetuese, ku të gjithë shtetasit shqiptarë të jenë të barabartë para
              ligjit, të miratuara me referendum popullor, duke përfshirë ndër të tjera:
              <ul>
                <li>Ndryshimin e Kodit Zgjedhor.</li>
                <li>Ndryshimin e ligjit për financimin e partive politike dhe organizatave të ndryshme.</li>
                <li>
                  Kufizimin e ushtrimit të detyrës së Kryeministrit në jo më shumë se dy mandate,
                  të plota ose të pjesshme, gjatë gjithë jetës politike të një individi.
                </li>
              </ul>
            </li>
            <li>
              Paralelisht, kërkojmë:
              <ul>
                <li>Anulimin e ndryshimeve të bëra në ligjin për “Zonat e Mbrojtura”.</li>
                <li>Anulimin e ndryshimeve të bëra në ligjin për “Trashëgiminë kulturore”.</li>
                <li>Shfuqizimin e paketës ligjore të njohur si “Paketa e Maleve”.</li>
                <li>Shfuqizimin e statusit dhe të kuadrit ligjor për “Investimet Strategjike”.</li>
              </ul>
            </li>
            <li>
              Hartimin e një kontrate të re sociale mes qytetarëve dhe shtetit, pas konsultimit me
              intelektualë, ekspertë teknikë dhe qytetarë apartiakë të propozuar nga sheshi i
              protestës.
            </li>
          </ol>
          <aside>
            <div class="times-six__demands-brand">
              <img
                class="times-six__demands-logo"
                src="/images/flamingo-wordmark-dark.svg"
                alt="Flamingo Revolution"
                width="426"
                height="187"
              />
              <a href="https://www.flamingorevolution.eu" aria-label="Hap flamingorevolution.eu">
                <span>flamingorevolution.eu</span>
                <img
                  class="times-six__demands-qr"
                  src="/images/qr-code/png/black.png"
                  alt="QR code për flamingorevolution.eu"
                  width="480"
                  height="480"
                />
              </a>
            </div>
          </aside>
        </section>
      </article>

      <footer class="times-source times-ten__source">
        <strong>FLAMINGO TIMES · Botimi X · Shtator 2026</strong>
        <span>Lexoje. Fotokopjoje. Shpërndaje.</span>
      </footer>
    </main>
  </SiteFrame>
</BaseLayout>
