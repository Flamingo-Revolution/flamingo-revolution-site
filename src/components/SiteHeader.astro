---
import type { Locale, SiteCopy } from "../data/site";
import LocaleSwitch from "./LocaleSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  copy: SiteCopy;
  currentPage: "home" | "documents" | "ideas" | "map" | "pulse" | "contact" | "times" | "blog" | "referendum";
  localePath?: string;
}

const { locale, copy, currentPage, localePath = "" } = Astro.props;

const homeHref = locale === "sq" ? "/" : "/en/";
const documentsHref = locale === "sq" ? "/projektligje/" : "/en/projektligje/";
const ideasHref = locale === "sq" ? "/idete-tuaja/" : "/en/idete-tuaja/";
const contactHref = locale === "sq" ? "/kontakt/" : "/en/kontakt/";
const mapHref = locale === "sq" ? "/harta/" : "/en/map/";
const pulseHref = "/pulsi-protestes/";
const timesHref = "/flamingo-times/";
const blogHref = "/blog/";

const mapLabel = locale === "sq" ? "Harta" : "Map";
const pulseLabel = locale === "sq" ? "Pulsi" : "Pulse";
---

<header class="topbar">
  <a class="brand" href={homeHref} aria-label={copy.nav.homeLabel}>
    <span class="brand__mark">
      <img class="brand__logo brand__logo--light" src="/images/flamingo-wordmark-light.svg" alt={copy.brand.logoAlt} width="419" height="187" />
      <img class="brand__logo brand__logo--dark" src="/images/flamingo-wordmark-dark.svg" alt="" width="426" height="187" aria-hidden="true" />
    </span>
  </a>

  <button
    class="menu-toggle"
    type="button"
    aria-controls="topbar-actions"
    aria-expanded="false"
    data-menu-toggle
  >
    <span class="menu-toggle__icon" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </span>
    <span>Menu</span>
  </button>

  <div class="topbar__actions" id="topbar-actions" data-menu-actions>
    <nav class="site-menu" aria-label={copy.nav.menuLabel}>
      {
        currentPage === "home" ? (
          <>
            <a href={homeHref} aria-current="page">{copy.nav.homeLabel}</a>
            <a href={timesHref}>{copy.nav.timesLabel}</a>
            <a href={blogHref}>{copy.nav.blogLabel}</a>
            <a href={documentsHref}>{copy.nav.documentsLabel}</a>
            <a href={ideasHref}>{copy.nav.ideasLabel}</a>
            <a href={mapHref}>{mapLabel}</a>
            <a href={pulseHref}>{pulseLabel}</a>
            <a href={contactHref}>{copy.nav.contactLabel}</a>
          </>
        ) : (
          <>
            <a href={homeHref} aria-current={currentPage === "home" ? "page" : undefined}>{copy.nav.homeLabel}</a>
            <a href={timesHref} aria-current={currentPage === "times" ? "page" : undefined}>
              {copy.nav.timesLabel}
            </a>
            <a href={blogHref} aria-current={currentPage === "blog" ? "page" : undefined}>
              {copy.nav.blogLabel}
            </a>
            <a href={documentsHref} aria-current={currentPage === "documents" ? "page" : undefined}>
              {copy.nav.documentsLabel}
            </a>
            <a href={ideasHref} aria-current={currentPage === "ideas" ? "page" : undefined}>
              {copy.nav.ideasLabel}
            </a>
            <a href={mapHref} aria-current={currentPage === "map" ? "page" : undefined}>
              {mapLabel}
            </a>
            <a href={pulseHref} aria-current={currentPage === "pulse" ? "page" : undefined}>
              {pulseLabel}
            </a>
            <a href={contactHref} aria-current={currentPage === "contact" ? "page" : undefined}>{copy.nav.contactLabel}</a>
          </>
        )
      }
    </nav>
    <a class="button button--primary topbar-cta" href={copy.hero.participateLink}>
      {copy.hero.primaryCta}
    </a>
    <LocaleSwitch currentLocale={locale} currentPath={localePath} />
    <ThemeToggle labels={copy.theme} />
  </div>
</header>

<script is:inline>
  const attachHeaderMenu = () => {
    document.querySelectorAll("[data-menu-toggle]").forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.menuBound === "true") return;

      const actionsId = button.getAttribute("aria-controls");
      const actions = actionsId ? document.getElementById(actionsId) : null;
      if (!actions) return;

      const mobileQuery = window.matchMedia("(max-width: 760px)");
      const setOpen = (isOpen) => {
        actions.dataset.open = isOpen ? "true" : "false";
        button.setAttribute("aria-expanded", isOpen ? "true" : "false");
      };
      const close = () => setOpen(false);

      button.dataset.menuBound = "true";
      setOpen(false);

      button.addEventListener("click", () => {
        setOpen(button.getAttribute("aria-expanded") !== "true");
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || button.getAttribute("aria-expanded") !== "true") return;

        close();
        button.focus();
      });

      actions.addEventListener("click", (event) => {
        if (!mobileQuery.matches || !(event.target instanceof Element)) return;
        if (event.target.closest("a")) close();
      });

      mobileQuery.addEventListener("change", close);
    });
  };

  document.addEventListener("astro:page-load", attachHeaderMenu);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", attachHeaderMenu, { once: true });
  } else {
    attachHeaderMenu();
  }
</script>
