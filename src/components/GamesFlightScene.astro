<style>
  .flight-scene {
    width: 100%;
    height: 100%;
    min-height: inherit;
    background: var(--accent-blue);
  }

  svg { display: block; width: 100%; height: 100%; min-height: inherit; overflow: hidden; }
  .stars, .moon { display: none; }
  .stars { fill: var(--ink); }
  .sun-rays { fill: none; stroke: #ffe172; stroke-width: 12; stroke-linecap: round; opacity: .62; }
  .sun circle, .moon { fill: #ffe172; stroke: var(--ink); stroke-width: 6; }
  .clouds { fill: var(--surface); stroke: var(--ink); stroke-width: 5; stroke-linejoin: round; }

  .wing-back { fill: #c83e72; stroke: var(--ink); stroke-width: 5; stroke-linejoin: round; }
  .legs-outline, .body-outline, .beak-outline { fill: none; stroke: var(--ink); stroke-linecap: round; }
  .legs-outline { stroke-width: 8; }
  .body-outline { stroke-width: 22; }
  .beak-outline { stroke-width: 12; }
  .body-outline-fill { fill: var(--ink); }
  .legs, .body { fill: none; stroke: var(--accent); stroke-linecap: round; }
  .legs { stroke-width: 4; }
  .body { stroke-width: 14; }
  .body-fill { fill: var(--accent); }
  .beak { fill: none; stroke: #fff; stroke-width: 6; stroke-linecap: round; }
  .beak-tip { fill: none; stroke: #000; stroke-width: 7; stroke-linecap: round; }
  .wing-front { fill: var(--accent); stroke: var(--ink); stroke-width: 5; stroke-linejoin: round; }

  .flock-flight { animation: flock-flight 35s linear infinite; }
  .flock-turn { animation: flock-turn 35s linear infinite; transform-origin: -40px center; }

  @keyframes flock-flight {
    0%, 1.4286% { transform: translate(-190px, 155px); }
    49.2857%, 50.7143% { transform: translate(990px, 155px); }
    98.5714%, 100% { transform: translate(-190px, 155px); }
  }

  @keyframes flock-turn {
    0%, 50.7142% { transform: scaleX(1); }
    50.7143%, 99.999% { transform: scaleX(-1); }
    100% { transform: scaleX(1); }
  }

  :global(html[data-theme='dark']) .flight-scene { background: #0f2735; }
  :global(html[data-theme='dark']) .sun { display: none; }
  :global(html[data-theme='dark']) .moon,
  :global(html[data-theme='dark']) .stars { display: block; }

  @media (prefers-reduced-motion: reduce) {
    .flock-flight, .flock-turn { animation: none; }
    .flock-flight { transform: translate(400px, 155px); }
  }
</style>
