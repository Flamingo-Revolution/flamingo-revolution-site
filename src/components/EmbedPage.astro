---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import type { Locale, SiteCopy } from "../data/site";

type NavPage =
  | "home"
  | "protests"
  | "map"
  | "pulse"
  | "diaspora"
  | "documents"
  | "ideas"
  | "times"
  | "dossier"
  | "about";

interface Props {
  locale: Locale;
  siteCopy: SiteCopy;
  currentPage: NavPage;
  localePath: string;
  title: string;
  description: string;
  src: string;
  heading?: string;
  lead?: string;
  links?: { label: string; href: string }[];
}

const {
  locale,
  siteCopy,
  currentPage,
  localePath,
  title,
  description,
  src,
  heading = title,
  lead,
  links = []
} = Astro.props;

const pageType = currentPage === "dossier" ? "CollectionPage" : "WebPage";
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  pageType={pageType}
  breadcrumbs={[
    { name: locale === "sq" ? "Ballina" : "Home", path: locale === "sq" ? "/" : "/en/" },
    { name: heading, path: `/${localePath}/` }
  ]}
>
  <div class="page-shell">
    <SiteHeader locale={locale} copy={siteCopy} currentPage={currentPage} localePath={localePath} />

    <main class="embed-page" id="main" tabindex="-1">
      {
        lead && (
          <section class="embed-intro sr-only">
            <p class="eyebrow">{locale === "sq" ? "Projekte" : "Projects"}</p>
            <h1>{heading}</h1>
            <p class="lead">{lead}</p>
            {links.length > 0 && (
              <nav class="embed-intro__links" aria-label={locale === "sq" ? "Lidhje të lidhura" : "Related links"}>
                {links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </nav>
            )}
          </section>
        )
      }
      <section class="embed-frame-section" aria-label={heading}>
        <div class="embed-frame">
          <iframe src={src} title={heading} loading="eager" allowfullscreen></iframe>
        </div>
      </section>
    </main>

    <SiteFooter locale={locale} copy={siteCopy} />
  </div>
</BaseLayout>
