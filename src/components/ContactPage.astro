---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFrame from "./SiteFrame.astro";
import type { Locale, SiteCopy } from "../data/site";

interface Props {
  locale: Locale;
  siteCopy: SiteCopy;
}

const { locale, siteCopy } = Astro.props;
const email = "info@flamingorevolution.eu";
const title = locale === "sq" ? "Kontakt" : "Contact";
const description =
  locale === "sq"
    ? "Kontaktoni Revolucionin Flamingo permes email-it zyrtar ose Discord."
    : "Contact Flamingo Revolution for media, documents, proposals and coordination.";
---

<BaseLayout title={`${title} | ${siteCopy.meta.title}`} description={description} locale={locale}>
  <SiteFrame {locale} copy={siteCopy} currentPage="contact" localePath="kontakt">
    <main class="contact-page" id="main" tabindex="-1">
      <section class="contact-hero">
        <div class="contact-hero__intro">
          <p class="eyebrow">{locale === "sq" ? "Na kontaktoni" : "Contact us"}</p>
          <h1>
            <span>{title}</span>
          </h1>
          <p class="lead">
            {
              locale === "sq"
                ? "Per pyetje, media, materiale ose koordinim, na shkruani ne adresen zyrtare te Revolucionit Flamingo."
                : "For questions, media, materials or coordination, write to the official Flamingo Revolution address."
            }
          </p>
        </div>

        <article class="contact-card">
          <p class="contact-card__kicker">{locale === "sq" ? "Email zyrtar" : "Official email"}</p>
          <a class="contact-card__email" href={`mailto:${email}`}>{email}</a>
          <p>
            {
              locale === "sq"
                ? "Pergjigjemi sa me shpejt qe te jete e mundur."
                : "We will respond as soon as possible."
            }
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href={`mailto:${email}`}>
              {locale === "sq" ? "Dergo email" : "Send email"}
            </a>
          </div>
        </article>
      </section>

      <section class="contact-details" aria-label={locale === "sq" ? "Detajet e kontaktit" : "Contact details"}>
        <article class="contact-panel">
          <h2>{locale === "sq" ? "Mendime dhe propozime" : "Opinions and proposals"}</h2>
          <p>
            {
              locale === "sq"
                ? "Per te ndare problematika, ide ose propozime qytetare, plotesoni formularin me poshte."
                : "To share civic problems, ideas or proposals, use the form so we can collect them clearly and structurally."
            }
          </p>
          <a class="button button--ghost" href={siteCopy.hero.participateLink} target="_blank" rel="noreferrer">
            {siteCopy.hero.primaryCta}
          </a>
        </article>

        <article class="contact-panel contact-panel--social">
          <h2>{locale === "sq" ? "Rrjetet sociale" : "Social channels"}</h2>
          <div class="contact-socials">
            {
              siteCopy.footer.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer">
                  {link.label}
                </a>
              ))
            }
          </div>
        </article>
      </section>
    </main>

  </SiteFrame>
</BaseLayout>
