---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale, SiteCopy } from "../data/site";
import SiteFrame from "./SiteFrame.astro";

interface Props {
  locale: Locale;
  copy: SiteCopy;
}

const { locale, copy } = Astro.props;
const titleWords = copy.hero.title.split(" ");
const documentsHref = locale === "sq" ? "/projektligje/" : "/en/projektligje/";
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale}>
  <SiteFrame {locale} {copy} currentPage="home">
    <main class="landing" id="main" tabindex="-1">
      <section class="hero">
        <div class="hero__content">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1>
            {titleWords.map((word) => <span>{word}</span>)}
          </h1>
          <p class="lead">{copy.hero.description}</p>

          <div class="hero__actions">
            <a class="button button--primary" href={copy.hero.participateLink}>
              {copy.hero.primaryCta}
            </a>
            <a class="button button--ghost" href={documentsHref}>
              {copy.hero.documentsCta}
            </a>
          </div>

          <ul class="metrics">
            {
              copy.hero.metrics.map((metric) => (
                <li class="metric-card">
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </li>
              ))
            }
          </ul>
        </div>

      </section>

      <section class="section-block stats-block" id="stats">
        <div class="section-heading">
          <p class="eyebrow">{copy.stats.kicker}</p>
          <h2>{copy.stats.title}</h2>
          <p>{copy.stats.description}</p>
        </div>

        <div class="stats-grid">
          {
            copy.stats.items.map((stat) => (
              <article class="stat-tile">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section-block" id="manifesto">
        <div class="section-heading">
          <p class="eyebrow">{copy.manifesto.kicker}</p>
          <h2>{copy.manifesto.title}</h2>
          <p>{copy.manifesto.description}</p>
        </div>

        <div class="card-grid">
          {
            copy.manifesto.cards.map((card) => (
              <article class="info-card">
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section-block" id="kerkesat">
        <div class="section-heading">
          <p class="eyebrow">{copy.hero.demandsKicker}</p>
          <h2>{copy.hero.demandsTitle}</h2>
        </div>

        <div class="council-board" aria-label={copy.hero.demandsTitle}>
          {
            copy.hero.demands.map((demand, index) => (
              <article class="council-note">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{demand}</strong>
              </article>
            ))
          }
        </div>
      </section>

      <section class="section-block section-block--accent" id="pillars">
        <div class="section-heading">
          <p class="eyebrow">{copy.pillars.kicker}</p>
          <h2>{copy.pillars.title}</h2>
        </div>

        <div class="pillar-grid">
          {
            copy.pillars.items.map((pillar, index) => (
              <article class="pillar-card">
                <span class="pillar-card__index">{String(index + 1).padStart(2, "0")}</span>
                <h3>{pillar.title}</h3>
                <p>{pillar.body}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="culture-note" id="culture">
        <span class="culture-note__mark" aria-hidden="true"></span>
        <div class="culture-note__content">
          <p class="eyebrow">{copy.culture.kicker}</p>
          <h2>{copy.culture.title}</h2>
          <p>{copy.culture.body}</p>
        </div>
      </section>

    </main>

  </SiteFrame>
</BaseLayout>
