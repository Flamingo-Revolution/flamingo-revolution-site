---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale, SiteCopy } from "../data/site";
import { protestsPageCopy } from "../data/protests";
import { getNavIcon } from "../data/navIcons";
import { splitTitleLines } from "../utils/text";
import SiteFrame from "./SiteFrame.astro";
import SectionMedia from "./SectionMedia.astro";
import CardSlider from "./CardSlider.astro";
import type { CardSliderItem } from "./CardSlider.astro";

interface Props {
  locale: Locale;
  copy: SiteCopy;
}

const { locale, copy } = Astro.props;
const titleWords = splitTitleLines(copy.hero.title);
const prefix = locale === "sq" ? "" : "/en";
const documentsHref = `${prefix}/projektligje/`;
const protestsHref = `${prefix}/protestat/`;
const protestsCopy = protestsPageCopy[locale];
const discordHref = copy.footer.links.find((link) => link.label === "Discord")?.href ?? "#";
const photoPlaceholder = protestsCopy.photoPlaceholderLabel;

// Every collection-shaped block on the page (stats, protest highlights,
// demands, projects, timeline) feeds the same CardSlider, so the page reads
// as one system instead of several one-off layouts. Each card can optionally
// carry a picture — the "who's protesting" pillars each have a real photo
// (see copy.pillars.items in site.ts); other collections without one fall
// back to the shared "coming soon" placeholder, and text-only blocks
// (stats, demands) simply skip the picture slot.
const pillarCards: CardSliderItem[] = copy.pillars.items.map((item) => ({
  title: item.title,
  description: item.body,
  ...(item.image ? { image: item.image } : { imagePlaceholder: photoPlaceholder })
}));

const projectCards: CardSliderItem[] = [
  {
    title: copy.nav.ideasLabel,
    href: `${prefix}/idete-tuaja/`,
    icon: getNavIcon("bulb"),
    description: "Ndani një ide apo problematikë qytetare.",
    image: { src: "/images/projects/idete.png", alt: "Lista e ideve qytetare të dorëzuara, me vota dhe komente" }
  },
  {
    title: copy.nav.documentsLabel,
    href: `${prefix}/projektligje/`,
    icon: getNavIcon("document"),
    description: "Projektligjet e propozuara, gati për t'u lexuar dhe shkarkuar.",
    image: { src: "/images/projects/ligjet.png", alt: "Faqe nga një projektligj, gati për t'u lexuar" }
  },
  {
    title: copy.nav.timesLabel,
    href: `${prefix}/flamingo-times/`,
    icon: getNavIcon("newspaper"),
    description: "Gazeta e lëvizjes, botim pas botimi.",
    image: { src: "/images/projects/ftimes.png", alt: "Faqja e Flamingo Times, botimet e fundit" }
  },
  {
    title: copy.nav.dossierLabel,
    href: `${prefix}/dosjet/`,
    icon: getNavIcon("folder"),
    description: "Dokumente dhe hetime të mbledhura.",
    image: { src: "/images/projects/dossier.webp", alt: "Harta e lidhjeve në Flamingo Dossier, mes dosjeve, institucioneve dhe personave" }
  },
  {
    title: copy.nav.mapLabel,
    href: `${prefix}/harta/`,
    icon: getNavIcon("map"),
    description: "Ku dhe kur ndodhen protestat.",
    image: { src: "/images/projects/harta.png", alt: "Harta e protestave në Evropë, me protestat aktuale dhe të ardhshme" }
  },
  {
    title: copy.nav.pulseLabel,
    href: `${prefix}/pulsi-protestes/`,
    icon: getNavIcon("pulse"),
    description: "Gjendja e gjallë e mobilizimit.",
    image: { src: "/images/projects/pulsi.png", alt: "Grafiku i Pulsit të Protestës, pjesëmarrja ditore ndër javë" }
  },
  {
    title: copy.nav.diasporaLabel,
    href: `${prefix}/diaspora-zbarkon/`,
    icon: getNavIcon("calendar"),
    description: "Aksionet e diasporës anembanë botës.",
    image: { src: "/images/projects/diaspora-zbarkon.png", alt: "Faqja e marshimit të diasporës, 14-16 Gusht 2026" }
  },
  {
    title: copy.nav.diasporaReportersLabel,
    href: `${prefix}/reporteret-e-diaspores/`,
    icon: getNavIcon("mic"),
    description: "Zërat që dokumentojnë nga jashtë.",
    image: { src: "/images/flamingo-times/botimi-4/mergimtari.jpg", alt: copy.nav.diasporaReportersLabel }
  }
];
---

<BaseLayout
  title={locale === "sq" ? "Revolucioni Flamingo | Lëvizje qytetare në Shqipëri" : "Flamingo Revolution | Civic movement in Albania"}
  description={copy.meta.description}
  locale={locale}
>
  <SiteFrame {locale} {copy} currentPage="home">
    <main class="landing" id="main" tabindex="-1">
      <section class="hero">
        <div class="hero__content">
          <p class="eyebrow">{copy.hero.eyebrow}</p>
          <h1>
            {titleWords.map((word) => <span>{word}</span>)}
          </h1>
          <p class="lead">{copy.hero.description}</p>


          <ul class="metrics">
            {
              copy.hero.metrics.map((metric) => (
                <li class="metric-card">
                  <strong>{metric.value}</strong>
                  <span>{metric.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <section class="section-block section-block--accent" id="protestat">
        <div class="section-heading">
          <p class="eyebrow">{copy.pillars.kicker}</p>
          <h2>Ne, flamingot, këmbëngulim!</h2>
          <p>{copy.pillars.teaser}</p>
        </div>

        <CardSlider items={pillarCards} ariaLabel={copy.pillars.title} />

        <div class="hero__actions">
          <a class="button button--primary" href={protestsHref}>Shiko protestat</a>
        </div>
      </section>

      <section class="section-block" id="projektet">
        <div class="section-heading">
          <p class="eyebrow">Projektet</p>
          <h2>Nismat që krijojnë ndryshim</h2>
          <p>
            Nga mbledhja e ideve tek harta e protestave dhe zërat e diasporës: këto janë hapësirat ku energjia
            qytetare kthehet në punë konkrete.
          </p>
        </div>

        <CardSlider
          items={projectCards}
          ariaLabel="Projektet"
          prevLabel="Projektet e mëparshme"
          nextLabel="Projektet e ardhshme"
        />
      </section>


      <section class="section-block section-block--accent stats-block" id="stats">
        <div class="section-heading">
          <p class="eyebrow">{copy.stats.kicker}</p>
          <h2>{copy.stats.title}</h2>
          <p>{copy.stats.description}</p>
        </div>

        <div class="stats-divider" role="separator">
          <span>{copy.stats.movementLabel}</span>
        </div>

        <div class="stats-grid">
          {
            copy.stats.movementItems.map((stat) => (
              <article class="stat-tile">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </article>
            ))
          }
        </div>

        <div class="stats-divider" role="separator">
          <span>{copy.stats.groupLabel}</span>
        </div>

        <div class="stats-grid">
          {
            copy.stats.groupItems.map((stat) => (
              <article class="stat-tile">
                <strong>{stat.value}</strong>
                <span>{stat.label}</span>
              </article>
            ))
          }
        </div>
      </section>


      <section class="section-block" id="culture">
        <div class="section-intro">
          <div class="section-heading">
            <p class="eyebrow">{copy.culture.kicker}</p>
            <h2>{copy.culture.title}</h2>
            <p>{copy.culture.body}</p>
            <div class="hero__actions">
              <a class="button button--primary" href={discordHref} target="_blank" rel="noreferrer">
                {copy.nav.joinLabel}
              </a>
            </div>
          </div>
          <SectionMedia src="/images/distributed.png" alt="Serveri i Discord-it të Revolucionit Flamingo, me kanale për çdo projekt e temë" />
        </div>
      </section>
    </main>

  </SiteFrame>
</BaseLayout>
