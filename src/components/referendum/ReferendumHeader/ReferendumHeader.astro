---
import ThemeToggle from "../../ThemeToggle.astro";
import type { SiteCopy } from "../../../data/site";

interface Props {
	copy: SiteCopy;
	brandHref?: string;
	brandExternal?: boolean;
}

const {
	copy,
	brandHref = "https://flamingorevolution.eu",
	brandExternal = brandHref.startsWith("http")
} = Astro.props;
---

<div class="referendum-header">
	<a
		class="referendum-header__brand"
		href={brandHref}
		target={brandExternal ? "_blank" : undefined}
		rel={brandExternal ? "noreferrer" : undefined}
		aria-label={copy.nav.homeLabel}
	>
		<img
			class="brand__logo brand__logo--light"
			src="/images/flamingo-wordmark-light.svg"
			alt={copy.brand.logoAlt}
			width="419"
			height="187"
		/>
		<img
			class="brand__logo brand__logo--dark"
			src="/images/flamingo-wordmark-dark.svg"
			alt=""
			width="426"
			height="187"
			aria-hidden="true"
		/>
	</a>

	<ThemeToggle labels={copy.theme} />
</div>
