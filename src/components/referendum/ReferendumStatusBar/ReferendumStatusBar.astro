---
interface Props {
	processHref?: string;
}

const { processHref = "/referendum/#procesi" } = Astro.props;
---

<div class="status-bar" role="status">
	<div class="shell status-inner">
		<span class="status-dot" aria-hidden="true"></span>
		<strong>Ku jemi tani:</strong>
		<span>Mbledhja e firmave niset së shpejti</span>
		<a href={processHref}>
			<span class="status-cta__full">Shiko procesin</span>
			<span class="status-cta__short">Procesi</span>
			<span aria-hidden="true">↓</span>
		</a>
	</div>
</div>
