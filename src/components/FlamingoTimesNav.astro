---
interface Props {
  current: "hub" | "archive";
}

const { current } = Astro.props;
---

<nav class="times-publication-nav" aria-label="Navigimi i Flamingo Times">
  <a href="/flamingo-times/" aria-current={current === "hub" ? "page" : undefined}>
    Flamingo Times
    <small>Gazeta e lëvizjes</small>
  </a>
  <a href="/flamingo-times/artikujt/" aria-current={current === "archive" ? "page" : undefined}>
    Artikujt
    <small>Kërko botimet e mëparshme në arkiv</small>
  </a>
</nav>
