---
const defaultBotOrigin = 'https://flamingo-bot-949711463853.europe-west3.run.app';
const configuredUrl = import.meta.env.PUBLIC_FLAMINGO_BOT_URL?.trim() || defaultBotOrigin;
const developmentProxyBase = '/api/flamingo-bot';

function resolveBotOrigin(value: string | undefined): string | undefined {
	if (!value) return undefined;

	let url: URL;
	try {
		url = new URL(value);
	} catch {
		throw new Error('PUBLIC_FLAMINGO_BOT_URL must be an absolute URL.');
	}

	const isLocalDevelopmentUrl =
		import.meta.env.DEV &&
		url.protocol === 'http:' &&
		(url.hostname === 'localhost' || url.hostname === '127.0.0.1');

	if (url.protocol !== 'https:' && !isLocalDevelopmentUrl) {
		throw new Error('PUBLIC_FLAMINGO_BOT_URL must use HTTPS outside local development.');
	}

	return url.origin;
}

const botOrigin = resolveBotOrigin(configuredUrl);
const widgetScriptUrl = botOrigin
	? import.meta.env.DEV
		? `${developmentProxyBase}/widget/flamingo-chat.js`
		: new URL('/widget/flamingo-chat.js', botOrigin).href
	: undefined;
const clientApiBase = import.meta.env.DEV ? developmentProxyBase : botOrigin;
const assetBase = import.meta.env.DEV ? `${developmentProxyBase}/widget/media` : undefined;
---

{
	botOrigin && widgetScriptUrl && (
		<>
			<script is:inline type="module" src={widgetScriptUrl}></script>
			<flamingo-chat
				api-base={clientApiBase}
				asset-base={assetBase}
				button-label="Ask Flamingo"
			></flamingo-chat>
			<script is:inline>
				(() => {
					const themeStyles = `
						:host {
							--flamingo-accent: var(--site-bot-accent) !important;
							--flamingo-ink: var(--site-bot-text) !important;
							--flamingo-muted: var(--site-bot-muted) !important;
							--flamingo-paper: var(--site-bot-surface) !important;
							color-scheme: inherit !important;
							color: var(--site-bot-text) !important;
							font-family: var(--site-bot-font-body) !important;
						}

						button:focus-visible,
						textarea:focus-visible,
						a:focus-visible {
							outline-color: var(--site-bot-accent) !important;
						}

						.launcher,
						article.user {
							background: var(--site-bot-ink) !important;
							color: var(--site-bot-ink-reverse) !important;
						}

						.launcher {
							border: 2px solid var(--site-bot-ink) !important;
							border-radius: 0 !important;
							box-shadow: 4px 4px 0 var(--site-bot-accent) !important;
							font-weight: 800 !important;
							touch-action: none !important;
							transition:
								box-shadow 160ms ease,
								transform 160ms ease !important;
						}

						.launcher:hover,
						.launcher:focus-visible {
							box-shadow: 6px 6px 0 var(--site-bot-accent) !important;
							transform: translate(-1px, -1px) !important;
						}

						.launcher:active {
							box-shadow: 1px 1px 0 var(--site-bot-accent) !important;
							transform: translate(2px, 2px) !important;
						}

						.mark {
							border: 2px solid var(--site-bot-ink-reverse) !important;
							border-radius: 0 !important;
							background-color: var(--site-bot-surface-strong) !important;
							background-image: url('/favicon-32x32.png') !important;
							background-position: center !important;
							background-repeat: no-repeat !important;
							background-size: 22px 22px !important;
							font-size: 0 !important;
						}

						.composer button {
							align-self: center !important;
							width: 38px !important;
							height: 38px !important;
							border: 2px solid var(--site-bot-ink) !important;
							border-radius: 0 !important;
							background: var(--site-bot-ink) !important;
							box-shadow: 3px 3px 0 var(--site-bot-accent) !important;
							color: var(--site-bot-ink-reverse) !important;
							transition:
								box-shadow 160ms ease,
								transform 160ms ease !important;
						}

						.composer button span {
							display: block !important;
							width: 18px !important;
							height: 18px !important;
							background: currentColor !important;
							font-size: 0 !important;
							-webkit-mask: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M2.01%2021%2023%2012%202.01%203%202%2010l15%202-15%202z'/%3E%3C/svg%3E") center / contain no-repeat !important;
							mask: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M2.01%2021%2023%2012%202.01%203%202%2010l15%202-15%202z'/%3E%3C/svg%3E") center / contain no-repeat !important;
						}

						.composer button:hover:not(:disabled) {
							background: var(--site-bot-ink) !important;
							box-shadow: 5px 5px 0 var(--site-bot-accent) !important;
							transform: translate(-1px, -1px) !important;
						}

						.composer button:active:not(:disabled) {
							box-shadow: 1px 1px 0 var(--site-bot-accent) !important;
							transform: translate(1px, 1px) !important;
						}

						.composer button:focus-visible {
							outline: 2px solid var(--site-bot-accent) !important;
							outline-offset: 4px !important;
						}

						.composer button:disabled {
							border-color: var(--site-bot-ink) !important;
							background: var(--site-bot-ink) !important;
							box-shadow: 3px 3px 0 var(--site-bot-accent) !important;
							color: var(--site-bot-ink-reverse) !important;
							cursor: wait !important;
							opacity: 0.65 !important;
						}

						.identity h2 {
							font-family: var(--site-bot-font-display) !important;
							font-weight: 700 !important;
						}

						.dialog {
							border: 2px solid var(--site-bot-ink) !important;
							border-radius: 0 !important;
							background: var(--site-bot-surface) !important;
							box-shadow: 8px 8px 0 var(--site-bot-accent) !important;
							color: var(--site-bot-text) !important;
						}

						.header,
						.disclosure,
						form {
							border-color: var(--site-bot-ink) !important;
							border-width: 2px !important;
						}

						.header,
						.messages {
							background: var(--site-bot-paper) !important;
							color: var(--site-bot-text) !important;
						}

						.header {
							cursor: grab !important;
							touch-action: none !important;
							user-select: none !important;
						}

						:host([data-dragging='true']) .header,
						:host([data-dragging='true']) .launcher {
							cursor: grabbing !important;
						}

						.messages {
							scrollbar-color: var(--site-bot-muted) var(--site-bot-surface) !important;
						}

						.avatar {
							border: 2px solid var(--site-bot-ink) !important;
							border-radius: 0 !important;
							background: var(--site-bot-surface-strong) !important;
							box-shadow: 3px 3px 0 var(--site-bot-accent) !important;
						}

						article {
							border: 2px solid var(--site-bot-ink) !important;
							border-radius: 0 !important;
							font-weight: 600 !important;
						}

						article.assistant {
							background: var(--site-bot-surface-strong) !important;
							box-shadow: 3px 3px 0 var(--site-bot-ink) !important;
							color: var(--site-bot-text) !important;
						}

						article.user {
							box-shadow: 3px 3px 0 var(--site-bot-accent) !important;
						}

						.reset {
							border: 2px solid var(--site-bot-ink) !important;
							border-radius: 0 !important;
							background: var(--site-bot-surface) !important;
							box-shadow: 2px 2px 0 var(--site-bot-accent) !important;
							color: var(--site-bot-text) !important;
							font-weight: 800 !important;
							transition:
								box-shadow 160ms ease,
								transform 160ms ease !important;
						}

						.reset:hover:not(:disabled) {
							border-color: var(--site-bot-ink) !important;
							background: var(--site-bot-surface) !important;
							box-shadow: 4px 4px 0 var(--site-bot-accent) !important;
							color: var(--site-bot-text) !important;
							transform: translate(-1px, -1px) !important;
						}

						.close {
							display: inline-grid !important;
							place-items: center !important;
							width: 38px !important;
							height: 38px !important;
							padding: 0 !important;
							border: 2px solid var(--site-bot-ink) !important;
							border-radius: 0 !important;
							background: var(--site-bot-surface) !important;
							box-shadow: 2px 2px 0 var(--site-bot-accent) !important;
							color: var(--site-bot-text) !important;
							font-weight: 800 !important;
							line-height: 1 !important;
							text-align: center !important;
							transition:
								box-shadow 160ms ease,
								transform 160ms ease !important;
						}

						.close:hover {
							background: var(--site-bot-surface) !important;
							box-shadow: 4px 4px 0 var(--site-bot-accent) !important;
							transform: translate(-1px, -1px) !important;
						}

						.disclosure {
							background: var(--site-bot-accent-soft) !important;
							box-shadow: inset 6px 0 0 var(--site-bot-accent) !important;
							color: var(--site-bot-text) !important;
							font-weight: 700 !important;
						}

						.citations {
							border-color: var(--site-bot-ink) !important;
							border-width: 2px !important;
						}

						.citations a,
						.citations li > span {
							color: var(--site-bot-text) !important;
						}

						.citations small,
						.identity p {
							color: var(--site-bot-muted) !important;
						}

						form {
							background: var(--site-bot-paper) !important;
							color: var(--site-bot-text) !important;
						}

						.composer {
							border: 2px solid var(--site-bot-ink) !important;
							border-radius: 0 !important;
							background: var(--site-bot-surface-strong) !important;
							box-shadow: 4px 4px 0 var(--site-bot-ink) !important;
							transition:
								border-color 140ms ease,
								box-shadow 140ms ease,
								transform 140ms ease !important;
						}

						.composer:focus-within {
							border-color: var(--site-bot-ink) !important;
							box-shadow: 6px 6px 0 var(--site-bot-accent) !important;
							transform: translate(-1px, -1px) !important;
						}

						textarea {
							color: var(--site-bot-text) !important;
							caret-color: var(--site-bot-accent) !important;
							font-weight: 700 !important;
						}

						textarea:focus,
						textarea:focus-visible {
							outline: none !important;
						}

						textarea::placeholder {
							color: var(--site-bot-muted) !important;
						}

						.error {
							border-left: 4px solid var(--site-bot-error) !important;
							color: var(--site-bot-error) !important;
							font-weight: 700 !important;
							padding-left: 8px !important;
						}

						@media (max-width: 520px) {
							.dialog {
								border-radius: 0 !important;
								box-shadow: 4px 4px 0 var(--site-bot-accent) !important;
							}

							.reset {
								border-radius: 0 !important;
							}
						}
					`;

					const palettes = {
						light: {
							accent: '#ff69b8',
							accentSoft: '#ffd7e3',
							error: '#b71950',
							ink: '#050505',
							inkReverse: '#fff3df',
							line: 'rgba(20, 20, 20, 0.18)',
							muted: '#5a514b',
							paper: '#f1ece6',
							shadow: '0 28px 70px rgba(0, 0, 0, 0.24)',
							surface: '#fff8ef',
							surfaceStrong: '#ffffff',
							text: '#141414'
						},
						dark: {
							accent: '#ff72bd',
							accentSoft: 'rgba(255, 114, 189, 0.2)',
							error: '#ff9fc1',
							ink: '#fff0dc',
							inkReverse: '#06080b',
							line: 'rgba(255, 240, 220, 0.18)',
							muted: '#cbbfb1',
							paper: '#121b22',
							shadow: '0 28px 80px rgba(0, 0, 0, 0.55)',
							surface: '#10171d',
							surfaceStrong: '#18232c',
							text: '#fff0dc'
						}
					};

					const syncWidgetTheme = (widget) => {
						const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
						const palette = palettes[theme];
						widget.dataset.siteTheme = theme;

						const properties = {
							'--flamingo-accent': palette.accent,
							'--flamingo-ink': palette.text,
							'--flamingo-muted': palette.muted,
							'--flamingo-paper': palette.surface,
							'--site-bot-accent': palette.accent,
							'--site-bot-accent-soft': palette.accentSoft,
							'--site-bot-error': palette.error,
							'--site-bot-ink': palette.ink,
							'--site-bot-ink-reverse': palette.inkReverse,
							'--site-bot-line': palette.line,
							'--site-bot-muted': palette.muted,
							'--site-bot-paper': palette.paper,
							'--site-bot-shadow': palette.shadow,
							'--site-bot-surface': palette.surface,
							'--site-bot-surface-strong': palette.surfaceStrong,
							'--site-bot-text': palette.text
						};

						Object.entries(properties).forEach(([property, value]) => {
							widget.style.setProperty(property, value, 'important');
						});
					};

					const dragObservers = new WeakMap();
					const dragLayouts = new WeakMap();
					const dragPadding = 8;

					const getHorizontalDockLimits = (surfaceWidth) => {
						const pageShell = document.querySelector('.page-shell');
						const shellRect =
							pageShell instanceof HTMLElement
								? pageShell.getBoundingClientRect()
								: { left: 0, right: window.innerWidth };
						const left = Math.max(dragPadding, shellRect.left);
						const rightEdge = Math.min(window.innerWidth - dragPadding, shellRect.right);

						return {
							left,
							right: Math.max(left, rightEdge - surfaceWidth)
						};
					};

					const setWidgetPosition = (widget, left, top) => {
						widget.style.setProperty('left', `${Math.round(left)}px`, 'important');
						widget.style.setProperty('top', `${Math.round(top)}px`, 'important');
						widget.style.setProperty('right', 'auto', 'important');
						widget.style.setProperty('bottom', 'auto', 'important');
						widget.dataset.userPositioned = 'true';
					};

					const clampWidgetToViewport = (
						widget,
						{ anchorBottom, preserveSide = false } = {}
					) => {
						const root = widget.shadowRoot;
						const surface = root?.querySelector('.dialog, .launcher');
						if (!(surface instanceof HTMLElement)) return;

						const rect = surface.getBoundingClientRect();
						const dockLimits = getHorizontalDockLimits(rect.width);
						const maxTop = Math.max(dragPadding, window.innerHeight - rect.height - dragPadding);
						const dockCenter = (dockLimits.left + dockLimits.right + rect.width) / 2;
						const rememberedSide = preserveSide ? widget.dataset.dockSide : undefined;
						const dockSide =
							rememberedSide === 'left' || rememberedSide === 'right'
								? rememberedSide
								: rect.left + rect.width / 2 < dockCenter
									? 'left'
									: 'right';
						const left = dockSide === 'left' ? dockLimits.left : dockLimits.right;
						const desiredTop = Number.isFinite(anchorBottom)
							? anchorBottom - rect.height
							: rect.top;
						const top = Math.min(Math.max(desiredTop, dragPadding), maxTop);

						setWidgetPosition(widget, left, top);
						widget.dataset.dockSide = dockSide;
						dragLayouts.set(widget, {
							kind: surface.classList.contains('dialog') ? 'dialog' : 'launcher',
							bottom: top + rect.height
						});
					};

					const bindDragHandle = (widget, handle, surface) => {
						if (handle.dataset.siteDragHandle === 'true') return;
						handle.dataset.siteDragHandle = 'true';

						let dragState = null;
						let suppressClick = false;

						handle.addEventListener(
							'click',
							(event) => {
								if (!suppressClick) return;
								event.preventDefault();
								event.stopImmediatePropagation();
								suppressClick = false;
							},
							true
						);

						handle.addEventListener('pointerdown', (event) => {
							if (!event.isPrimary || event.button !== 0) return;
							if (
								handle !== surface &&
								event.target instanceof Element &&
								event.target.closest('button, a, input, textarea, select')
							) {
								return;
							}

							const rect = surface.getBoundingClientRect();
							dragState = {
								pointerId: event.pointerId,
								startX: event.clientX,
								startY: event.clientY,
								left: rect.left,
								top: rect.top,
								width: rect.width,
								height: rect.height,
								moved: false
							};
							handle.setPointerCapture(event.pointerId);
						});

						handle.addEventListener('pointermove', (event) => {
							if (!dragState || event.pointerId !== dragState.pointerId) return;

							const deltaX = event.clientX - dragState.startX;
							const deltaY = event.clientY - dragState.startY;
							if (!dragState.moved && Math.hypot(deltaX, deltaY) < 5) return;

							dragState.moved = true;
							widget.dataset.dragging = 'true';
							const dockLimits = getHorizontalDockLimits(dragState.width);
							const maxTop = Math.max(
								dragPadding,
								window.innerHeight - dragState.height - dragPadding
							);
							const left = Math.min(
								Math.max(dragState.left + deltaX, dockLimits.left),
								dockLimits.right
							);
							const top = Math.min(Math.max(dragState.top + deltaY, dragPadding), maxTop);

							setWidgetPosition(widget, left, top);
							event.preventDefault();
						});

						const finishDrag = (event) => {
							if (!dragState || event.pointerId !== dragState.pointerId) return;
							const moved = dragState.moved;
							dragState = null;
							delete widget.dataset.dragging;
							if (handle.hasPointerCapture(event.pointerId)) {
								handle.releasePointerCapture(event.pointerId);
							}

							if (moved) {
								clampWidgetToViewport(widget);
								suppressClick = true;
								window.setTimeout(() => {
									suppressClick = false;
								}, 250);
							}
						};

						handle.addEventListener('pointerup', finishDrag);
						handle.addEventListener('pointercancel', finishDrag);
					};

					const installWidgetDragging = (widget, root) => {
						const wireVisibleSurface = () => {
							const launcher = root.querySelector('.launcher');
							if (launcher instanceof HTMLElement) {
								launcher.title = 'Drag to move · Click to open';
								bindDragHandle(widget, launcher, launcher);
							}

							const dialog = root.querySelector('.dialog');
							const header = root.querySelector('.header');
							if (dialog instanceof HTMLElement && header instanceof HTMLElement) {
								header.title = 'Drag to move chat';
								bindDragHandle(widget, header, dialog);
							}

							const surface = dialog instanceof HTMLElement ? dialog : launcher;
							if (!(surface instanceof HTMLElement)) return;

							const kind = surface.classList.contains('dialog') ? 'dialog' : 'launcher';
							const previousLayout = dragLayouts.get(widget);
							const anchorBottom =
								previousLayout && previousLayout.kind !== kind
									? previousLayout.bottom
									: undefined;

							requestAnimationFrame(() =>
								clampWidgetToViewport(widget, { anchorBottom, preserveSide: true })
							);
						};

						wireVisibleSurface();
						if (dragObservers.has(widget)) return;

						const observer = new MutationObserver(wireVisibleSurface);
						observer.observe(root, { childList: true, subtree: true });
						dragObservers.set(widget, observer);
					};

					const installThemeBridge = async () => {
						await customElements.whenDefined('flamingo-chat');
						await new Promise((resolve) => {
							requestAnimationFrame(() => requestAnimationFrame(resolve));
						});

						document.querySelectorAll('flamingo-chat').forEach((widget) => {
							syncWidgetTheme(widget);
							const root = widget.shadowRoot;
							if (!root) return;

							const existingStyle = root.querySelector('style[data-flamingo-site-theme]');
							const style = existingStyle ?? document.createElement('style');
							if (!existingStyle) style.dataset.flamingoSiteTheme = '';
							style.textContent = themeStyles;
							// Re-appending also moves an existing bridge after the widget's own styles.
							root.append(style);
							installWidgetDragging(widget, root);
						});
					};

					void installThemeBridge();
					document.addEventListener('astro:page-load', installThemeBridge);
					new MutationObserver(() => {
						document.querySelectorAll('flamingo-chat').forEach(syncWidgetTheme);
					}).observe(document.documentElement, {
						attributes: true,
						attributeFilter: ['data-theme']
					});
					window.addEventListener('resize', () => {
						document
							.querySelectorAll('flamingo-chat')
							.forEach((widget) => clampWidgetToViewport(widget, { preserveSide: true }));
					});
				})();
			</script>
		</>
	)
}

<style is:global>
	flamingo-chat {
		--flamingo-accent: var(--accent);
		--flamingo-ink: var(--text);
		--flamingo-muted: var(--muted);
		--flamingo-paper: var(--surface);
		--site-bot-accent: var(--accent);
		--site-bot-accent-soft: var(--accent-soft);
		--site-bot-error: var(--accent-strong);
		--site-bot-ink: var(--ink);
		--site-bot-ink-reverse: var(--ink-reverse);
		--site-bot-line: var(--line);
		--site-bot-muted: var(--muted);
		--site-bot-paper: var(--paper);
		--site-bot-shadow: var(--shadow);
		--site-bot-surface: var(--surface);
		--site-bot-surface-strong: var(--surface-strong);
		--site-bot-text: var(--text);
		--site-bot-font-body: var(--font-body);
		--site-bot-font-display: var(--font-display);
	}
</style>
