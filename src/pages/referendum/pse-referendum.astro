---
import ReferendumLayout from "../../layouts/ReferendumLayout.astro";
import ReferendumStatusBar from "../../components/referendum/ReferendumStatusBar/ReferendumStatusBar.astro";
import ReferendumSubnav from "../../components/referendum/ReferendumSubnav/ReferendumSubnav.astro";
import ReferendumReveal from "../../components/referendum/ReferendumReveal/ReferendumReveal.astro";
import PseReferendumArticle from "../../components/referendum/PseReferendumArticle/PseReferendumArticle.astro";
import "../../styles/referendum-landing.css";

export const prerender = true;

const title = "Pse referendum për Ligjin 21/2024 | Revolucioni Flamingo";
const description =
	"Katër arsye të dokumentuara për shfuqizimin e Ligjit nr. 21/2024: Zvërneci, Narta, Vjosa dhe nisma qytetare.";
---

<ReferendumLayout
	title={title}
	description={description}
	pageType="Article"
	breadcrumbs={[
		{ name: "Ballina", path: "/" },
		{ name: "Referendum", path: "/referendum/" },
		{ name: "Pse referendum?", path: "/referendum/pse-referendum/" }
	]}
>
	<div class="referendum-landing referendum-subpage">
		<ReferendumStatusBar />
		<main id="main" tabindex="-1">
			<div class="shell page-return">
				<a href="/referendum/">← Kthehu në faqen kryesore</a>
			</div>
			<ReferendumSubnav current="pse-referendum" />
			<PseReferendumArticle />
		</main>
	</div>
	<ReferendumReveal />
</ReferendumLayout>
