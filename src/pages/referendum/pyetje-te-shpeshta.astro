---
import ReferendumLayout from "../../layouts/ReferendumLayout.astro";
import ReferendumStatusBar from "../../components/referendum/ReferendumStatusBar/ReferendumStatusBar.astro";
import ReferendumSubnav from "../../components/referendum/ReferendumSubnav/ReferendumSubnav.astro";
import ReferendumReveal from "../../components/referendum/ReferendumReveal/ReferendumReveal.astro";
import FaqPage from "../../components/referendum/FAQSection/components/FaqPage/FaqPage.svelte";
import { siteCopy } from "../../data/site";
import "../../styles/referendum-landing.css";

export const prerender = true;

const copy = siteCopy.sq;
const title = "Pyetje të shpeshta";
const description = "Pyetje dhe përgjigje për firmat, KQZ-në dhe procesin e referendumit.";
---

<ReferendumLayout title={`${title} | ${copy.meta.title}`} description={description}>
	<div class="referendum-landing referendum-subpage">
		<ReferendumStatusBar />
		<main id="main" tabindex="-1">
			<div class="shell page-return">
				<a href="/referendum/">← Kthehu në faqen kryesore</a>
			</div>
			<ReferendumSubnav current="pyetje-te-shpeshta" />
			<FaqPage client:load />
		</main>
	</div>
	<ReferendumReveal />
</ReferendumLayout>
