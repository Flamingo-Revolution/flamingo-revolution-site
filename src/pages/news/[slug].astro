---
import type { Prisma } from "@prisma/client";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFrame from "../../components/SiteFrame.astro";
import ArticleView from "../../components/News/ArticleView.astro";
import { siteCopy } from "../../data/site";
import { createPrisma } from "@lib/db";
import { getDatabaseUrl } from "@lib/env/server";
import { formatArticleDate, readingTimeLabel } from "@lib/articles/format";
import { plainText, renderArticleHtml, summarize } from "@lib/articles/render";
import { normalizeMediaUrl } from "@lib/media";

export const prerender = false;

const slug = Astro.params.slug?.trim();

if (!slug) {
	return Astro.redirect("/news/");
}

const databaseUrl = getDatabaseUrl();

if (!databaseUrl) {
	return new Response("Database is not configured", { status: 500 });
}

const prisma = createPrisma(databaseUrl);

type ArticleWithReporter = Prisma.ArticleGetPayload<{
	include: { reporter: { select: { name: true } } };
}>;

let article: ArticleWithReporter | null = null;

try {
	article = await prisma.article.findFirst({
		where: { slug, status: "PUBLISHED" },
		include: { reporter: { select: { name: true } } }
	});
} catch (error) {
	console.error("News article error:", error);
	return new Response("Article could not be loaded", { status: 502 });
} finally {
	await prisma.$disconnect();
}

if (!article) {
	return new Response(null, { status: 404, statusText: "Not found" });
}

const body = renderArticleHtml(article.content);
const coverImageUrl = article.coverImageUrl ? normalizeMediaUrl(article.coverImageUrl) : null;
const description = article.excerpt || summarize(article.content, 160) || siteCopy.sq.meta.description;
const publishedLabel = formatArticleDate(article.publishedAt);
const readingLabel = readingTimeLabel(plainText(article.content));
const updatedLabel =
	article.updatedAt && article.publishedAt && article.updatedAt.getTime() - article.publishedAt.getTime() > 60_000
		? formatArticleDate(article.updatedAt)
		: "";
---

<BaseLayout
	title={`${article.title} | ${siteCopy.sq.meta.title}`}
	description={description}
	locale="sq"
	pageType="NewsArticle"
	rssPath="/news/rss.xml"
	publishedTime={article.publishedAt ?? undefined}
	modifiedTime={article.updatedAt}
	authorName={article.reporter.name}
	socialImagePath={coverImageUrl ?? undefined}
	socialImageAlt={coverImageUrl ? article.title : undefined}
	breadcrumbs={[
		{ name: "Ballina", path: "/" },
		{ name: "Lajme", path: "/news/" },
		{ name: article.title, path: `/news/${article.slug}/` }
	]}
>
	<SiteFrame locale="sq" copy={siteCopy.sq} currentPage="news" localePath="news">
		<ArticleView
			title={article.title}
			excerpt={article.excerpt}
			tags={article.tags}
			coverImageUrl={coverImageUrl}
			publishedIso={article.publishedAt?.toISOString() ?? null}
			publishedLabel={publishedLabel}
			updatedLabel={updatedLabel}
			authorName={article.reporter.name}
			readingLabel={readingLabel}
			bodyHtml={body}
			backHref="/news/"
			backLabel="← Të gjitha lajmet"
		/>
	</SiteFrame>
</BaseLayout>
