---
import type { Prisma } from "@prisma/client";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFrame from "../../components/SiteFrame.astro";
import { siteCopy } from "../../data/site";
import { createPrisma } from "@lib/db";
import { getDatabaseUrl } from "@lib/env/server";
import { formatArticleDate } from "@lib/articles/format";
import { renderArticleHtml, summarize } from "@lib/articles/render";
import { normalizeMediaUrl } from "@lib/media";

export const prerender = false;

const slug = Astro.params.slug?.trim();

if (!slug) {
	return Astro.redirect("/news/");
}

const databaseUrl = getDatabaseUrl();

if (!databaseUrl) {
	return new Response("Database is not configured", { status: 500 });
}

const prisma = createPrisma(databaseUrl);

type ArticleWithReporter = Prisma.ArticleGetPayload<{
	include: { reporter: { select: { name: true } } };
}>;

let article: ArticleWithReporter | null = null;

try {
	article = await prisma.article.findFirst({
		where: { slug, status: "PUBLISHED" },
		include: { reporter: { select: { name: true } } }
	});
} catch (error) {
	console.error("News article error:", error);
	return new Response("Article could not be loaded", { status: 502 });
} finally {
	await prisma.$disconnect();
}

if (!article) {
	return new Response(null, { status: 404, statusText: "Not found" });
}

const body = renderArticleHtml(article.content);
const coverImageUrl = article.coverImageUrl ? normalizeMediaUrl(article.coverImageUrl) : null;
const description = article.excerpt || summarize(article.content, 160) || siteCopy.sq.meta.description;
const publishedLabel = formatArticleDate(article.publishedAt);
const updatedLabel =
	article.updatedAt && article.publishedAt && article.updatedAt.getTime() - article.publishedAt.getTime() > 60_000
		? formatArticleDate(article.updatedAt)
		: "";
---

<BaseLayout
	title={`${article.title} | ${siteCopy.sq.meta.title}`}
	description={description}
	locale="sq"
	pageType="NewsArticle"
	publishedTime={article.publishedAt ?? undefined}
	modifiedTime={article.updatedAt}
	authorName={article.reporter.name}
	socialImagePath={coverImageUrl ?? undefined}
	socialImageAlt={coverImageUrl ? article.title : undefined}
	breadcrumbs={[
		{ name: "Ballina", path: "/" },
		{ name: "Lajme", path: "/news/" },
		{ name: article.title, path: `/news/${article.slug}/` }
	]}
>
	<SiteFrame locale="sq" copy={siteCopy.sq} currentPage="news" localePath="news">
		<main class="news-article" id="main" tabindex="-1">
			<nav class="news-article__back" aria-label="Navigim">
				<a href="/news/">← Të gjitha lajmet</a>
			</nav>

			<header class="news-article__header">
				<p class="news-article__meta">
					{publishedLabel && <time datetime={article.publishedAt?.toISOString()}>{publishedLabel}</time>}
					{article.reporter.name && <span>· {article.reporter.name}</span>}
				</p>
				<h1>{article.title}</h1>
				{article.excerpt && <p class="news-article__lead">{article.excerpt}</p>}
				{
					article.tags.length > 0 && (
						<p class="news-article__tags">
							{article.tags.map((tag) => (
								<span class="news-article__tag">{tag}</span>
							))}
						</p>
					)
				}
			</header>

			{
				coverImageUrl && (
					<img class="news-article__cover" src={coverImageUrl} alt={article.title} decoding="async" />
				)
			}

			<div class="news-article__body" set:html={body} />

			{updatedLabel && <p class="news-article__updated">Përditësuar më {updatedLabel}</p>}
		</main>
	</SiteFrame>
</BaseLayout>

<style>
	.news-article {
		width: 100%;
		max-width: 52rem;
		margin: 0 auto;
		padding: 2rem clamp(1rem, 5vw, 3.4rem) 4rem;
	}

	.news-article__back {
		margin-bottom: 1.6rem;
	}

	.news-article__back a {
		font-weight: 800;
		color: var(--text);
		text-decoration: none;
	}

	.news-article__back a:hover,
	.news-article__back a:focus-visible {
		color: var(--accent-strong);
	}

	.news-article__header {
		padding-bottom: 1.4rem;
		margin-bottom: 1.8rem;
		border-bottom: 3px solid var(--ink);
	}

	.news-article__meta {
		margin: 0 0 0.5rem;
		font-size: 0.8rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent-strong);
	}

	h1 {
		margin: 0 0 0.8rem;
		font-size: clamp(2rem, 5.5vw, 3.1rem);
		line-height: 1.1;
		font-weight: 800;
	}

	.news-article__lead {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.6;
		color: var(--muted);
	}

	.news-article__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 1rem 0 0;
	}

	.news-article__tag {
		padding: 0.1rem 0.5rem;
		font-size: 0.75rem;
		font-weight: 800;
		text-transform: lowercase;
		background: var(--accent-soft);
		border: 2px solid var(--ink);
	}

	.news-article__cover {
		width: 100%;
		margin-bottom: 2rem;
		border: 2px solid var(--ink);
		box-shadow: 8px 8px 0 var(--ink);
	}

	.news-article__updated {
		margin-top: 2.5rem;
		font-size: 0.85rem;
		font-style: italic;
		color: var(--muted);
	}

	/* Rendered article body (allowlisted HTML from Tiptap JSON). */
	.news-article__body {
		font-size: 1.06rem;
		line-height: 1.75;
	}

	.news-article__body :global(h2) {
		margin: 2.2rem 0 0.8rem;
		font-size: 1.75rem;
		line-height: 1.2;
		font-weight: 800;
	}

	.news-article__body :global(h3) {
		margin: 1.8rem 0 0.6rem;
		font-size: 1.35rem;
		line-height: 1.25;
		font-weight: 800;
	}

	.news-article__body :global(p) {
		margin: 0 0 1.15rem;
	}

	.news-article__body :global(ul),
	.news-article__body :global(ol) {
		margin: 0 0 1.15rem;
		padding-left: 1.4rem;
	}

	.news-article__body :global(li) {
		margin-bottom: 0.4rem;
	}

	.news-article__body :global(blockquote) {
		margin: 1.6rem 0;
		padding: 0.6rem 1.2rem;
		border-left: 4px solid var(--accent);
		background: var(--paper);
		font-family: var(--font-display);
		font-style: italic;
		font-size: 1.2em;
	}

	.news-article__body :global(img) {
		max-width: 100%;
		height: auto;
		margin: 1.6rem 0;
		border: 2px solid var(--ink);
		box-shadow: 6px 6px 0 var(--ink);
	}

	.news-article__body :global(a) {
		color: var(--accent-strong);
		text-decoration: underline;
	}

	.news-article__body :global(hr) {
		margin: 2.2rem 0;
		border: none;
		border-top: 3px solid var(--ink);
	}

	.news-article__body :global(code) {
		padding: 0.1rem 0.3rem;
		font-size: 0.92em;
		background: var(--paper-cool);
		border: 1px solid var(--line);
	}

	.news-article__body :global(pre) {
		margin: 1.6rem 0;
		padding: 1rem;
		overflow-x: auto;
		background: var(--paper-cool);
		border: 2px solid var(--ink);
	}

	.news-article__body :global(pre code) {
		padding: 0;
		background: none;
		border: none;
	}
</style>
