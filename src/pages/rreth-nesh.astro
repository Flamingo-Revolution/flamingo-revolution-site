---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFrame from "../components/SiteFrame.astro";
import PageHero from "../components/PageHero.astro";
import { siteCopy } from "../data/site";
import { aboutPageCopy } from "../data/about";

const locale = "sq";
const siteCopyLocale = siteCopy[locale];
const copy = aboutPageCopy[locale];

// Ekipi mund të rritet shumë (300+ kontribues). Në vend të fshehim shumicën
// pas një "+N kontribues" statik, i shfaqim TË GJITHË në një mur me kolona
// që lëvizin pafund (CSS-only, pa timer JS) — kështu lista mund të rritet
// pa u bërë e ngjeshur apo pa fshehur njeri.
const TEAM_WALL_COLUMNS = 5;
const shuffledMembers = [...copy.ekipi.members].sort(() => Math.random() - 0.5);
const teamColumns = Array.from({ length: TEAM_WALL_COLUMNS }, (_, col) =>
  shuffledMembers.filter((_, i) => i % TEAM_WALL_COLUMNS === col)
).filter((column) => column.length > 0);
---

<BaseLayout
  title={copy.meta.title}
  description={copy.meta.description}
  locale={locale}
  pageType="AboutPage"
  breadcrumbs={[
    { name: locale === "sq" ? "Ballina" : "Home", path: "/" },
    { name: copy.hero.title, path: "/rreth-nesh/" }
  ]}
>
  <SiteFrame locale={locale} copy={siteCopyLocale} currentPage="about" localePath="rreth-nesh">
    <main class="about-page" id="main" tabindex="-1">
      <PageHero
        eyebrow={copy.hero.eyebrow}
        title={copy.hero.title}
        lead={copy.hero.lead}
        primaryCta={{ label: copy.hero.primaryCta, href: siteCopyLocale.hero.participateLink }}
        secondaryCta={{ label: copy.hero.secondaryCta, href: "#misioni" }}
        panelTitle={copy.hero.panelTitle}
        panelLinks={copy.hero.panelLinks}
      />

      <section class="section-block mission-section" id="misioni">
        <div class="section-heading">
          <p class="eyebrow">{copy.misioni.kicker}</p>
          <h2>{copy.misioni.title}</h2>
        </div>

        <div class="mission-section__content">
          <p>{copy.misioni.description}</p>
          <p class="mission-section__principle">
            {copy.misioni.principles.map((principle) => <span>{principle}</span>)}
          </p>
        </div>
      </section>

      <section class="section-block section-block--accent mission-section" id="rregullorja">
        <div class="section-heading">
          <p class="eyebrow">{copy.rregullorja.kicker}</p>
          <h2>{copy.rregullorja.title}</h2>
        </div>

        <div class="mission-section__content">
          <p>{copy.rregullorja.description}</p>
          <p class="mission-section__principle">
            {copy.rregullorja.rules.map((rule, index) => <span>{index + 1}. {rule}</span>)}
          </p>
        </div>
      </section>

      <section class="section-block" id="ekipi">
        <div class="section-heading">
          <p class="eyebrow">{copy.ekipi.kicker}</p>
          <h2>{copy.ekipi.title}</h2>
          <p>{copy.ekipi.description}</p>
        </div>

        <div class="team-wall" aria-hidden="true">
          {
            teamColumns.map((names, colIndex) => (
              <div class="team-wall__col" style={`--team-wall-duration: ${22 + colIndex * 4}s`}>
                <div class="team-wall__track">
                  <div class="team-wall__group">
                    {names.map((name) => (
                      <span class="team-wall__name">{name}</span>
                    ))}
                  </div>
                  <div class="team-wall__group">
                    {names.map((name) => (
                      <span class="team-wall__name">{name}</span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
        <p class="sr-only">
          {copy.ekipi.members.join(", ")}. {copy.ekipi.moreLabel}.
        </p>
        <p class="team-wall__more">{copy.ekipi.moreLabel}</p>
      </section>

      <section class="section-block section-block--accent mission-section" id="transparenca">
        <div class="section-heading">
          <p class="eyebrow">{copy.transparenca.kicker}</p>
          <h2>{copy.transparenca.title}</h2>
        </div>

        <div class="mission-section__content">
          <p>{copy.transparenca.description}</p>
          <p class="mission-section__principle">
            {copy.transparenca.points.map((point) => <span>{point}</span>)}
          </p>
        </div>
      </section>

      <section class="section-block mission-section" id="partneret">
        <div class="section-heading">
          <p class="eyebrow">{copy.partneret.kicker}</p>
          <h2>{copy.partneret.title}</h2>
        </div>

        <div class="mission-section__content">
          <p>{copy.partneret.description}</p>
          <p class="mission-section__principle">
            {copy.partneret.categories.map((category) => <span>{category}</span>)}
          </p>
        </div>
      </section>

      <section class="contact-hero" id="kontakt">
        <div class="contact-hero__intro">
          <p class="eyebrow">{copy.kontakt.kicker}</p>
          <h2>{copy.kontakt.title}</h2>
          <p class="lead">{copy.kontakt.lead}</p>
        </div>

        <article class="contact-card">
          <p class="contact-card__kicker">{copy.kontakt.emailKicker}</p>
          <a class="contact-card__email" href={`mailto:${copy.kontakt.email}`}>{copy.kontakt.email}</a>
          <p>{copy.kontakt.emailNote}</p>
          <div class="hero__actions">
            <a class="button button--primary" href={`mailto:${copy.kontakt.email}`}>
              {copy.kontakt.emailCta}
            </a>
          </div>
        </article>
      </section>
    </main>
  </SiteFrame>
</BaseLayout>

<style>
  .mission-section {
    display: grid;
    grid-template-columns: minmax(12rem, 0.65fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }

  .mission-section .section-heading {
    margin-bottom: 0;
  }

  .mission-section__content {
    display: grid;
    gap: 1.35rem;
    padding-left: clamp(1rem, 3vw, 1.6rem);
    border-left: 0.3rem solid var(--accent);
  }

  .mission-section__content p {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .mission-section__content .mission-section__principle {
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 3vw, 2rem);
    font-weight: 800;
    line-height: 1.15;
  }

  .mission-section__principle span {
    display: block;
  }

  /* Muri i kontribuesve: kolona vertikale që lëvizin pafund (CSS-only).
     Çdo kolonë përmban listën e vet dyfishuar (.team-wall__group x2) dhe
     lëviz translateY(-50%) — pikërisht sa një kopje, kështu lakohet pa u
     ndjerë ndërprerja. Drejtimi alternon çift/tek dhe kohëzgjatja ndryshon
     pak nga kolona në kolonë (--team-wall-duration), që të mos lëvizin në
     unison dhe të duket më organike. */
  .team-wall {
    height: 300px;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.65rem;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
    mask-image: linear-gradient(to bottom, transparent, #000 14%, #000 86%, transparent);
  }

  .team-wall__col {
    overflow: hidden;
  }

  .team-wall__track {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    animation: team-wall-scroll linear infinite;
    animation-duration: var(--team-wall-duration, 24s);
  }

  .team-wall__col:nth-child(even) .team-wall__track {
    animation-direction: reverse;
  }

  .team-wall__group {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  @keyframes team-wall-scroll {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }

  .team-wall:hover .team-wall__track {
    animation-play-state: paused;
  }

  .team-wall__name {
    padding: 0.55rem 0.5rem;
    border: 2px solid var(--ink);
    background: var(--surface);
    color: var(--text);
    font-weight: 800;
    font-size: 0.82rem;
    text-align: center;
    overflow-wrap: anywhere;
    box-shadow: 3px 3px 0 var(--ink);
  }

  .team-wall__col:nth-child(3n+2) .team-wall__name {
    background: var(--paper-cool);
  }

  .team-wall__col:nth-child(3n) .team-wall__name {
    background: var(--accent-soft);
  }

  .team-wall__more {
    margin: 1rem 0 0;
    color: var(--muted);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .team-wall {
      height: auto;
      overflow: visible;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .team-wall__track {
      animation: none;
    }

    .team-wall__group:nth-child(2) {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .mission-section {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .team-wall {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      height: 220px;
    }

    /* Only 2 of the 5 desktop columns fit without clipping at this width;
       hide the rest instead of letting the grid wrap them into a row that
       gets cut off by the fixed height + overflow: hidden above. */
    .team-wall__col:nth-child(n + 3) {
      display: none;
    }
  }
</style>
