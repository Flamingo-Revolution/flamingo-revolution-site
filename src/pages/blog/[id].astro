---
import { getCollection, getEntry, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { siteCopy } from "../../data/site";

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection("blog", ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post }
	}));
}

interface Props {
	post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const author = await getEntry(post.data.author);
const copy = siteCopy.sq;

const months = [
	"janar",
	"shkurt",
	"mars",
	"prill",
	"maj",
	"qershor",
	"korrik",
	"gusht",
	"shtator",
	"tetor",
	"nëntor",
	"dhjetor"
];
const formatDate = (date: Date) =>
	`${date.getUTCDate()} ${months[date.getUTCMonth()]} ${date.getUTCFullYear()}`;
---

<BaseLayout title={`${post.data.title} | ${copy.meta.title}`} description={post.data.description} locale="sq">
	<div class="page-shell">
		<SiteHeader locale="sq" copy={copy} currentPage="blog" localePath="blog" />

		<main class="blog-post" id="main" tabindex="-1">
			<article>
				<header class="blog-post__header">
					<p class="eyebrow">
						<a href="/blog/">Blog</a>
					</p>
					<h1>{post.data.title}</h1>
					<p class="lead">{post.data.description}</p>
					<p class="blog-post__byline">
						<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
						{
							author && (
								<>
									<span aria-hidden="true"> · </span>
									<span>
										{author.data.name}
										{author.data.portfolio ? (
											<>
												{" "}
												(
												<a href={author.data.portfolio} target="_blank" rel="noreferrer">
													profili
												</a>
												)
											</>
										) : null}
									</span>
								</>
							)
						}
					</p>
					{author && <p class="blog-post__author-bio">{author.data.bio}</p>}
				</header>

				<div class="blog-post__body">
					<Content />
				</div>
			</article>
		</main>

		<footer class="footer-note">
			<p>{copy.footer.text}</p>
			<nav class="footer-links" aria-label="Social links">
				{
					copy.footer.links.map((link) => (
						<a href={link.href} target="_blank" rel="noreferrer">
							{link.label}
						</a>
					))
				}
			</nav>
		</footer>
	</div>
</BaseLayout>

<style>
	.blog-post {
		background: var(--paper);
	}

	.blog-post__header {
		padding: clamp(1.4rem, 5vw, 3.6rem) clamp(1rem, 5vw, 3.4rem) 1.5rem;
		background:
			radial-gradient(circle at 86% 22%, rgba(255, 105, 184, 0.18), transparent 26%),
			linear-gradient(135deg, var(--paper-warm), var(--paper-cool));
		border-bottom: 1px solid var(--line);
	}

	.blog-post__header h1 {
		margin: 0.2rem 0 0.8rem;
		max-width: 18ch;
		font-family: var(--font-display);
		font-size: clamp(2.4rem, 6vw, 4rem);
		line-height: 0.98;
	}

	.blog-post__header .lead {
		max-width: 40rem;
		margin: 0 0 1rem;
	}

	.blog-post__byline {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.blog-post__byline a {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.blog-post__author-bio {
		margin: 0.75rem 0 0;
		max-width: 40rem;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.55;
	}

	.blog-post__body {
		padding: clamp(1.5rem, 4vw, 2.6rem) clamp(1rem, 5vw, 3.4rem) clamp(2rem, 5vw, 3.4rem);
		max-width: 42rem;
		font-size: 1.05rem;
		line-height: 1.7;
	}

	.blog-post__body :global(p) {
		margin: 0 0 1.1rem;
	}

	.blog-post__body :global(p:last-child) {
		margin-bottom: 0;
	}

	.blog-post__body :global(a) {
		color: var(--accent-strong);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
</style>
