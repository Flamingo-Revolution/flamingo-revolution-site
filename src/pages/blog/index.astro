---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import { siteCopy } from "../../data/site";

export const prerender = true;

const copy = siteCopy.sq;
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = "Blog";
const description = "Artikuj dhe përditësime nga Revolucioni Flamingo.";

const months = [
	"janar",
	"shkurt",
	"mars",
	"prill",
	"maj",
	"qershor",
	"korrik",
	"gusht",
	"shtator",
	"tetor",
	"nëntor",
	"dhjetor"
];
const formatDate = (date: Date) =>
	`${date.getUTCDate()} ${months[date.getUTCMonth()]} ${date.getUTCFullYear()}`;
---

<BaseLayout title={`${title} | ${copy.meta.title}`} description={description} locale="sq">
	<div class="page-shell">
		<SiteHeader locale="sq" copy={copy} currentPage="blog" localePath="blog" />

		<main class="blog-page" id="main" tabindex="-1">
			<section class="blog-hero">
				<p class="eyebrow">Përditësime</p>
				<h1><span>{title}</span></h1>
				<p class="lead">{description}</p>
			</section>

			<section class="blog-list" aria-label="Lista e artikujve">
				{
					posts.map((post) => (
						<article class="blog-list__item">
							<a href={`/blog/${post.id}/`}>
								<time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
								<h2>{post.data.title}</h2>
								<p>{post.data.description}</p>
							</a>
						</article>
					))
				}
			</section>
		</main>

		<footer class="footer-note">
			<p>{copy.footer.text}</p>
			<nav class="footer-links" aria-label="Social links">
				{
					copy.footer.links.map((link) => (
						<a href={link.href} target="_blank" rel="noreferrer">
							{link.label}
						</a>
					))
				}
			</nav>
		</footer>
	</div>
</BaseLayout>

<style>
	.blog-page {
		display: grid;
		gap: 0;
		background: var(--paper);
	}

	.blog-hero {
		padding: clamp(1.4rem, 5vw, 3.6rem) clamp(1rem, 5vw, 3.4rem);
		background:
			radial-gradient(circle at 86% 22%, rgba(255, 105, 184, 0.18), transparent 26%),
			linear-gradient(135deg, var(--paper-warm), var(--paper-cool));
	}

	.blog-hero h1 {
		margin: 0.2rem 0 0.8rem;
		font-family: var(--font-display);
		font-size: clamp(2.6rem, 7vw, 4.4rem);
		line-height: 0.95;
	}

	.blog-hero .lead {
		max-width: 40rem;
		margin: 0;
	}

	.blog-list {
		display: grid;
		gap: 0;
		padding: 0 clamp(1rem, 5vw, 3.4rem) clamp(2rem, 5vw, 3.4rem);
		border-top: 1px solid var(--line);
	}

	.blog-list__item {
		border-bottom: 1px solid var(--line);
	}

	.blog-list__item a {
		display: grid;
		gap: 0.45rem;
		padding: 1.35rem 0;
	}

	.blog-list__item time {
		color: var(--muted);
		font-size: 0.88rem;
		letter-spacing: 0.02em;
	}

	.blog-list__item h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 3vw, 2rem);
		line-height: 1.1;
	}

	.blog-list__item p {
		margin: 0;
		max-width: 42rem;
		color: var(--muted);
		line-height: 1.55;
	}

	.blog-list__item a:hover h2,
	.blog-list__item a:focus-visible h2 {
		color: var(--accent-strong);
	}
</style>
