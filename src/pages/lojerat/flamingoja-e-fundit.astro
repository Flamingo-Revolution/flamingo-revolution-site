---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFrame from "../../components/SiteFrame.astro";
import { siteCopy } from "../../data/site";
import { gameSocialImage } from "../../data/games";

export const prerender = true;

const copy = siteCopy.sq;
const gamePath = "https://flamingo-revolution.github.io/flock-the-system/";
---

<BaseLayout
  title="Flamingoja e Fundit | Këndi i Lojërave"
  description="Drejto flamingon në një vrap satirik me pengesa, slogane dhe ritmin e protestës."
  locale="sq"
  canonicalPath="/lojerat/flamingoja-e-fundit/"
  {...gameSocialImage}
  breadcrumbs={[
    { name: "Ballina", path: "/" },
    { name: "Këndi i Lojërave", path: "/lojerat/" },
    { name: "Flamingoja e Fundit", path: "/lojerat/flamingoja-e-fundit/" }
  ]}
>
  <SiteFrame locale="sq" {copy} currentPage="games" shellClass="games-shell">
    <main class="flock-game" id="main" tabindex="-1">
      <nav class="flock-game__bar" aria-label="Navigimi i lojës">
        <a href="/lojerat/"><span aria-hidden="true">←</span> Të gjitha lojërat</a>
        <a href={gamePath} target="_blank" rel="noopener">Hap në dritare të re ↗</a>
      </nav>

      <section class="flock-game__stage" aria-label="Flamingoja e Fundit">
        <iframe
          id="flock-game-frame"
          src={gamePath}
          title="Luaj Flamingoja e Fundit"
          loading="eager"
          allow="autoplay; fullscreen; gamepad; clipboard-write"
          allowfullscreen
        ></iframe>
      </section>
    </main>
  </SiteFrame>
</BaseLayout>

<style>
  .flock-game { position: relative; z-index: 1; min-height: 100svh; background: #101827; }

  .flock-game__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 5vw, 3.4rem);
    border-bottom: 3px solid var(--ink);
    background: var(--paper-cool);
  }

  .flock-game__bar a {
    border-bottom: 0.16rem solid var(--accent);
    font: inherit;
    font-weight: 800;
    color: inherit;
    background: none;
    border-top: 0;
    border-right: 0;
    border-left: 0;
    padding: 0;
    text-decoration: none;
  }

  .flock-game__bar a:hover,
  .flock-game__bar a:focus-visible { color: var(--accent-strong); }

  .flock-game__stage {
    min-height: calc(100svh - 4rem);
    padding: clamp(0.75rem, 2vw, 1.25rem);
    background:
      linear-gradient(180deg, rgba(255, 95, 159, 0.18), rgba(16, 24, 39, 0) 28%),
      #101827;
  }

  .flock-game__stage iframe {
    display: block;
    width: 100%;
    height: min(78svh, 52rem);
    min-height: 38rem;
    border: 3px solid #151515;
    background: #101827;
    box-shadow: 9px 9px 0 #151515;
  }

  @media (max-width: 720px) {
    .flock-game__bar { align-items: flex-start; font-size: 0.82rem; }
    .flock-game__stage { padding: 0; }
    .flock-game__stage iframe {
      height: calc(100svh - 4.25rem);
      min-height: 32rem;
      border-right: 0;
      border-left: 0;
      box-shadow: none;
    }
  }
</style>
