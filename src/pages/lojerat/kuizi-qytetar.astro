---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFrame from "../../components/SiteFrame.astro";
import QytetarQuiz from "../../components/QytetarQuiz.svelte";
import GameShare from "../../components/GameShare.astro";
import { siteCopy } from "../../data/site";
import { quizSocialImage } from "../../data/games";

export const prerender = true;

const copy = siteCopy.sq;
---

<BaseLayout
  title="Kuizi Qytetar | Këndi i Lojërave"
  description="Testo njohuritë për shërbimet publike, mjedisin, premtimet elektorale dhe të drejtat qytetare."
  locale="sq"
  canonicalPath="/lojerat/kuizi-qytetar/"
  {...quizSocialImage}
  breadcrumbs={[
    { name: "Ballina", path: "/" },
    { name: "Këndi i Lojërave", path: "/lojerat/" },
    { name: "Kuizi Qytetar", path: "/lojerat/kuizi-qytetar/" }
  ]}
>
  <SiteFrame locale="sq" {copy} currentPage="games" shellClass="games-shell">
    <main class="game-detail" id="main" tabindex="-1">
      <nav class="game-detail__bar" aria-label="Navigimi i lojës">
        <a href="/lojerat/"><span aria-hidden="true">←</span> Të gjitha lojërat</a>
        <a href="/lojerat/rama-apo-berisha/">Rama apo Berisha? <span aria-hidden="true">→</span></a>
      </nav>
      <div class="game-detail__stage">
        <QytetarQuiz client:load>
          <GameShare slot="share" title="Kuizi Qytetar" path="/lojerat/kuizi-qytetar/" compact />
        </QytetarQuiz>
      </div>
    </main>
  </SiteFrame>
</BaseLayout>

<style>
  .game-detail { position: relative; z-index: 1; }
  .game-detail__bar {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem clamp(1rem, 5vw, 3.4rem);
    border-bottom: 3px solid var(--ink);
    background: var(--paper-cool);
  }
  .game-detail__bar a { border-bottom: 0.16rem solid var(--accent); font-weight: 800; }
  .game-detail__bar a:hover,
  .game-detail__bar a:focus-visible { color: var(--accent-strong); }
  .game-detail__stage { padding: clamp(2.2rem, 6vw, 5rem) clamp(1rem, 5vw, 3.4rem) clamp(4rem, 8vw, 7rem); }

  @media (max-width: 520px) {
    .game-detail__bar { align-items: flex-start; font-size: 0.82rem; }
    .game-detail__stage { padding-right: 0.75rem; padding-left: 0.75rem; }
  }
</style>
