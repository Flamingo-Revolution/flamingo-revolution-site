---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteFrame from "../../components/SiteFrame.astro";
import GameShare from "../../components/GameShare.astro";
import { siteCopy } from "../../data/site";
import { birdsSocialImage } from "../../data/games";

export const prerender = true;
const copy = siteCopy.sq;
const gamePath = "/games/zogjte-e-axhituar/index.html";
---

<BaseLayout
  title="Zogjtë e Axhituar | Këndi i Lojërave"
  description="Nis zogjtë në fluturim, mbro Lagunën e Nartës dhe sfido rekordin tënd."
  locale="sq"
  canonicalPath="/lojerat/zogjte-e-axhituar/"
  {...birdsSocialImage}
  breadcrumbs={[
    { name: "Ballina", path: "/" },
    { name: "Këndi i Lojërave", path: "/lojerat/" },
    { name: "Zogjtë e Axhituar", path: "/lojerat/zogjte-e-axhituar/" }
  ]}
>
  <SiteFrame locale="sq" {copy} currentPage="games" shellClass="games-shell">
    <main id="main" tabindex="-1">
      <nav aria-label="Navigimi i lojës">
        <a href="/lojerat/">← Të gjitha lojërat</a>
        <a href={gamePath} target="_blank" rel="noopener">Hap në dritare të re ↗</a>
      </nav>
      <header class="game-masthead">
        <p class="game-label">Laguna e Nartës</p>
        <div class="game-title-row">
          <h1>Zogjtë e Axhituar</h1>
          <div class="game-title-share"><GameShare title="Zogjtë e Axhituar" path="/lojerat/zogjte-e-axhituar/" compact /></div>
        </div>
        <p class="game-description">Nis zogjtë në fluturim, mbro Lagunën e Nartës dhe sfido rekordin tënd.</p>
      </header>
      <iframe src={gamePath} title="Luaj Zogjtë e Axhituar" allow="fullscreen" allowfullscreen></iframe>
    </main>
  </SiteFrame>
</BaseLayout>

<style>
  main { position: relative; z-index: 1; }
  nav { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; padding: 1rem clamp(1rem, 5vw, 3.4rem); border-bottom: 3px solid var(--ink); background: var(--paper-cool); }
  nav a { border-bottom: 0.16rem solid var(--accent); font-weight: 800; }
  .game-masthead { position: relative; z-index: 40; padding: clamp(2.2rem, 6vw, 5rem) 1rem 1.4rem; text-align: center; }
  .game-label { display: inline-block; margin: 0 0 0.8rem; padding: 0.35rem 0.7rem; border: 2px solid var(--ink); background: var(--accent-soft); box-shadow: 3px 3px 0 var(--ink); color: var(--accent-strong); font-size: 0.75rem; font-weight: 800; letter-spacing: 0.11em; text-transform: uppercase; }
  .game-title-row { display: flex; align-items: center; justify-content: center; gap: 0.8rem; max-width: 36rem; margin: 0 auto; }
  .game-title-row h1 { display: block; min-width: 0; max-width: none; margin: 0; color: var(--text); font-size: clamp(2.2rem, 7vw, 3.6rem); line-height: 0.95; text-align: center; }
  .game-title-share { flex-shrink: 0; text-align: left; }
  .game-description { max-width: 31rem; margin: 0.8rem auto 0; color: var(--muted); font-weight: 700; line-height: 1.45; }
  iframe { display: block; width: 100%; height: 80vh; height: 80dvh; min-height: 680px; border: 0; background: #0f1a18; }
  @media (max-width: 520px) { iframe { min-height: 620px; } }
</style>
