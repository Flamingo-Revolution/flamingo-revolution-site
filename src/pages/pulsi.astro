---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteCopy } from "../data/site";

const locale = "sq";
const copy = siteCopy[locale];
const pulseUrl = "https://www.diaspora-zbarkon.com/pulsi";
const pulsePoints =
  "0.0,88.0 5.4,79.5 10.8,75.5 16.3,77.9 21.7,84.0 27.1,82.3 32.5,50.0 37.9,79.1 43.3,59.6 48.8,80.0 54.2,68.0 59.6,69.4 65.0,67.8 70.4,77.4 75.8,73.2 81.3,81.7 86.7,83.7 92.1,82.9 97.5,84.4 102.9,85.2 108.3,8.0 113.8,85.7 119.2,85.5 124.6,86.3 130.0,87.4 135.4,85.8 140.8,86.6 146.3,84.9 151.7,86.2 157.1,84.0 162.5,80.7 167.9,86.7 173.3,85.7 178.8,87.1 184.2,41.6 189.6,86.1 195.0,87.6 200.4,88.0 205.8,85.5 211.3,84.3 216.7,86.1 222.1,83.1 227.5,87.1 232.9,86.9 238.3,86.8 243.8,87.6 249.2,86.8 254.6,86.6 260.0,84.3";
---

<BaseLayout
  title={`Pulsi | ${copy.meta.title}`}
  description="Ndiq pulsin e protestës: pjesëmarrja e dokumentuar dhe momentet kyçe."
  locale={locale}
>
  <div class="page-shell pulse-shell">
    <SiteHeader locale={locale} copy={copy} currentPage="pulse" />

    <main class="pulse-page" id="main" tabindex="-1">
      <section class="pulse-hero">
        <div class="pulse-copy">
          <p class="pulse-kicker">Indeksi i pjesëmarrjes</p>
          <h1>
            <span>Në shesh</span>
            <span>çdo ditë,</span>
            <span>ditë pas dite.</span>
          </h1>
          <p class="pulse-body">
            Ndiq pulsin e protestës: pjesëmarrje e dokumentuar qartësisht në kamera,
            përgjatë një muaji, me momentet kyçe: nga vala e parë e 6 qershorit te
            marshimi drejt Rinasit dhe kulmi i diasporës më 20 qershor.
          </p>

          <ul class="pulse-stats" aria-label="Shifrat kryesore">
            <li>
              <strong>Çdo ditë</strong>
              <span>protestë në shesh</span>
            </li>
            <li>
              <strong>20.06</strong>
              <span>dita më e madhe</span>
            </li>
            <li>
              <strong>100K+</strong>
              <span>vlerësim në shesh</span>
            </li>
          </ul>

          <a class="button button--primary pulse-button" href={pulseUrl} target="_blank" rel="noreferrer">
            <span class="pulse-button__icon" aria-hidden="true">⌁</span>
            Shiko pulsin e protestës
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <figure class="pulse-preview">
          <figcaption>
            <span>Pjesëmarrja e dokumentuar</span>
            <strong>6–20 qershor</strong>
          </figcaption>
          <svg viewBox="0 0 260 96" preserveAspectRatio="none" role="img" aria-label="Grafik i pulsit të pjesëmarrjes">
            <defs>
              <linearGradient id="pulse-spark" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.4" />
                <stop offset="100%" stop-color="var(--accent)" stop-opacity="0" />
              </linearGradient>
            </defs>
            <polygon points={`0,96 ${pulsePoints} 260,96`} fill="url(#pulse-spark)" />
            <polyline
              points={pulsePoints}
              fill="none"
              stroke="var(--accent-strong)"
              stroke-width="2.4"
              stroke-linejoin="round"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
            />
          </svg>
          <div class="pulse-axis" aria-hidden="true">
            <span>6 qershor</span>
            <span>20 qershor</span>
            <span>Sot</span>
          </div>
        </figure>
      </section>

      <section class="pulse-note">
        <span class="pulse-note__mark" aria-hidden="true"></span>
        <p>
          Të dhënat e plota, kronologjia dhe metodologjia gjenden te platforma{" "}
          <strong>Diaspora Zbarkon.</strong>
        </p>
        <a href={pulseUrl} target="_blank" rel="noreferrer">Hap platformën ↗</a>
      </section>
    </main>

    <footer class="footer-note">
      <p>{copy.footer.text}</p>
      <nav class="footer-links" aria-label="Links">
        {copy.footer.links.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">{link.label}</a>
        ))}
      </nav>
    </footer>
  </div>
</BaseLayout>

<style>
  :global(body) {
    background: #090909;
  }

  .pulse-shell {
    min-height: 100vh;
    background:
      radial-gradient(circle at 76% 18%, rgba(185, 28, 28, 0.18), transparent 28rem),
      #151515;
    color: #fff;
  }

  .pulse-page {
    width: min(1240px, 100%);
    margin: 0 auto;
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1rem, 5vw, 3.5rem);
  }

  .pulse-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.82fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .pulse-kicker {
    margin: 0 0 1rem;
    color: #fecaca;
    font-size: 0.82rem;
    font-weight: 850;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pulse-copy h1 {
    display: block;
    max-width: 13ch;
    margin: 0;
    color: #fff;
    font-size: clamp(3.1rem, 7vw, 6.7rem);
    font-weight: 850;
    line-height: 0.91;
    letter-spacing: -0.055em;
  }

  .pulse-body {
    max-width: 38rem;
    margin: 1.5rem 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    line-height: 1.65;
  }

  .pulse-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem clamp(1.6rem, 4vw, 3rem);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pulse-stats li {
    display: grid;
    gap: 0.35rem;
  }

  .pulse-stats strong {
    color: #ef4444;
    font-size: clamp(1.75rem, 3.5vw, 2.55rem);
    line-height: 1;
  }

  .pulse-stats span {
    color: rgba(255, 255, 255, 0.64);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .pulse-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    min-height: 3.2rem;
    margin-top: 2rem;
    padding: 0.8rem 1.1rem;
    border: 2px solid #ef4444;
    background: #b91c1c;
    color: #fff;
    box-shadow: 5px 5px 0 #681010;
    font-weight: 800;
    transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .pulse-button:hover,
  .pulse-button:focus-visible {
    background: #8f1717;
    transform: translate(-2px, -2px);
    box-shadow: 7px 7px 0 #681010;
  }

  .pulse-button__icon {
    color: #fecaca;
    font-size: 1.45rem;
  }

  .pulse-preview {
    margin: 0;
    padding: clamp(1.2rem, 3vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(0, 0, 0, 0.25));
    box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.48);
  }

  .pulse-preview figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pulse-preview figcaption strong {
    color: #fecaca;
  }

  .pulse-preview svg {
    display: block;
    width: 100%;
    height: clamp(11rem, 22vw, 16rem);
    overflow: visible;
  }

  .pulse-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.9rem;
    padding-top: 0.7rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .pulse-note {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    margin-top: clamp(3rem, 8vw, 6rem);
    padding: 1.1rem 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }

  .pulse-note__mark {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 0 0.35rem rgba(239, 68, 68, 0.16);
  }

  .pulse-note p {
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }

  .pulse-note strong {
    color: #fff;
  }

  .pulse-note a {
    color: #fecaca;
    font-weight: 800;
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .pulse-hero {
      grid-template-columns: 1fr;
    }

    .pulse-copy h1 {
      max-width: 15ch;
    }
  }

  @media (max-width: 620px) {
    .pulse-page {
      padding-top: 2.5rem;
    }

    .pulse-copy h1 {
      font-size: clamp(2.65rem, 14vw, 4.3rem);
    }

    .pulse-button {
      width: 100%;
    }

    .pulse-preview {
      padding: 1rem;
    }

    .pulse-preview figcaption,
    .pulse-note {
      grid-template-columns: 1fr;
      flex-direction: column;
      align-items: flex-start;
    }

    .pulse-note__mark {
      display: none;
    }
  }
</style>

<style>
  :global(body) {
    background:
      linear-gradient(90deg, rgba(255, 105, 184, 0.1) 1px, transparent 1px),
      linear-gradient(180deg, rgba(113, 183, 218, 0.08) 1px, transparent 1px),
      var(--bg);
    background-size: 42px 42px;
  }

  .pulse-shell {
    min-height: auto;
    color: var(--text);
    background:
      linear-gradient(180deg, var(--accent) 0 1.3rem, transparent 1.3rem),
      radial-gradient(circle at 86% 32%, rgba(113, 183, 218, 0.2), transparent 25rem),
      var(--paper);
  }

  .pulse-page {
    position: relative;
    z-index: 1;
    width: 100%;
    margin: 0;
    padding: 0;
    background: var(--paper);
  }

  .pulse-hero {
    grid-template-columns: minmax(0, 1fr) minmax(300px, 0.9fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    padding: clamp(2rem, 6vw, 4rem) clamp(1rem, 5vw, 3.4rem);
    border-bottom: 4px solid var(--line);
    background:
      radial-gradient(circle at 88% 20%, rgba(255, 105, 184, 0.2), transparent 26%),
      linear-gradient(135deg, var(--paper-warm), var(--paper-cool));
  }

  .pulse-kicker {
    color: var(--accent-strong);
    font-weight: 800;
  }

  .pulse-copy h1 {
    display: grid;
    gap: 0.14em;
    justify-items: start;
    max-width: 14ch;
    color: var(--ink-reverse);
    font-size: clamp(2.85rem, 6.6vw, 5.35rem);
    font-weight: 800;
    line-height: 0.96;
    letter-spacing: 0;
  }

  .pulse-copy h1 span {
    display: block;
    width: fit-content;
    padding: 0.02em 0.13em 0.09em;
    background: var(--ink);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    white-space: nowrap;
  }

  .pulse-body {
    color: var(--muted);
    font-weight: 700;
  }

  .pulse-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .pulse-stats li {
    min-width: 0;
    padding: 0.8rem;
    border: 2px solid var(--ink);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .pulse-stats li:nth-child(2) {
    background: var(--paper-cool);
    transform: rotate(0.7deg);
  }

  .pulse-stats li:nth-child(3) {
    background: var(--accent-soft);
    transform: rotate(-0.5deg);
  }

  .pulse-stats strong {
    color: var(--accent-strong);
    font-size: clamp(1.4rem, 2.8vw, 2rem);
    overflow-wrap: anywhere;
  }

  .pulse-stats span {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .pulse-button {
    min-height: 3rem;
    padding: 0.82rem 1.1rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--ink-reverse);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .pulse-button:hover,
  .pulse-button:focus-visible {
    background: var(--ink);
    transform: translate(-1px, -1px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .pulse-button__icon {
    color: var(--accent);
  }

  .pulse-preview {
    border: 3px solid var(--ink);
    border-radius: 0;
    background:
      linear-gradient(90deg, rgba(255, 105, 184, 0.12) 1px, transparent 1px),
      linear-gradient(180deg, rgba(113, 183, 218, 0.16) 1px, transparent 1px),
      var(--surface);
    background-size: 28px 28px;
    box-shadow: 8px 8px 0 var(--ink);
    transform: rotate(0.65deg);
  }

  .pulse-preview figcaption,
  .pulse-axis {
    color: var(--muted);
  }

  .pulse-preview figcaption strong {
    color: var(--accent-strong);
  }

  .pulse-axis {
    border-top: 2px solid var(--ink);
  }

  .pulse-note {
    margin-top: 0;
    padding: 1.2rem clamp(1rem, 5vw, 3.4rem);
    border-top: 0;
    border-bottom: 4px solid var(--line);
    background: var(--paper);
  }

  .pulse-note__mark {
    border: 2px solid var(--ink);
    border-radius: 0;
    background: var(--accent);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .pulse-note p {
    color: var(--muted);
  }

  .pulse-note strong {
    color: var(--text);
  }

  .pulse-note a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-decoration-thickness: 0.15rem;
    text-underline-offset: 0.25rem;
  }

  @media (max-width: 900px) {
    .pulse-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .pulse-shell {
      width: 100%;
      max-width: none;
      margin: 0;
    }

    .pulse-copy h1 {
      font-size: clamp(2.15rem, 9.4vw, 3.25rem);
    }

    .pulse-copy h1 span {
      white-space: normal;
    }

    .pulse-stats {
      grid-template-columns: 1fr;
      width: calc(100% - 4px);
    }

    .pulse-stats li,
    .pulse-preview {
      transform: none;
    }
  }
</style>
