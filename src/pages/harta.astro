---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { siteCopy } from "../data/site";

const locale = "sq";
const copy = siteCopy[locale];

const mapUrl = "https://pomodoren.github.io/flamingo-map/";
---

<BaseLayout
  title={`Harta | ${copy.meta.title}`}
  description="Harta e protestave të Revolucionit Flamingo."
  locale={locale}
>
  <div class="map-page">
    <SiteHeader
      locale={locale}
      copy={copy}
      currentPage="map"
      localePath="map"
    />

    <main id="main">
      <iframe
        src={mapUrl}
        title="Harta e protestave"
        loading="eager"
        allowfullscreen
      ></iframe>
    </main>
  </div>
</BaseLayout>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    height: 100%;
    overflow: hidden;
  }

  .map-page {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  main {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
