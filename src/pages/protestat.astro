---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteFrame from "../components/SiteFrame.astro";
import PageHero from "../components/PageHero.astro";
import CardSlider from "../components/CardSlider.astro";
import type { CardSliderItem } from "../components/CardSlider.astro";
import SectionMedia from "../components/SectionMedia.astro";
import { siteCopy } from "../data/site";
import { protestsPageCopy } from "../data/protests";
import { demandsV2 } from "../data/demands";

const locale = "sq";
const siteCopyLocale = siteCopy[locale];
const copy = protestsPageCopy[locale];

// Merged from the former /protestat/ + /kerkesat/ pages into one reading
// order: why it started, the habitat, other reasons, chronology, demands,
// way out. /kerkesat/ now just redirects to #kerkesat below.

// Each timeline card links to its source via "Lexo lajmin (hostname) →",
// with the hostname read straight off the href so it can't drift.
const newsSourceHost = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, "");
  } catch {
    return undefined;
  }
};

const historikuCards: CardSliderItem[] = copy.historiku.timeline.map((item) => {
  const host = item.href ? newsSourceHost(item.href) : undefined;
  return {
    href: item.href,
    linkLabel: item.href ? `${copy.newsLinkLabel}${host ? ` (${host})` : ""} →` : undefined,
    badge: item.env ? copy.historiku.envBadgeLabel : undefined,
    eyebrow: item.date,
    title: item.title,
    description: item.body,
    meta: `${item.location} · ${item.status}`,
    ...(item.image ? { image: item.image } : { imagePlaceholder: copy.photoPlaceholderLabel })
  };
});

const speciesItems: CardSliderItem[] = copy.speciesCards.map((card) => ({
  title: card.title,
  eyebrow: card.meta,
  description: card.description,
  image: card.image
}));

// v1 reuses the landing page's short list, v2 reuses demandsV2 — one
// source of truth instead of copies that can drift.
const kerkesatV1 = siteCopyLocale.hero.demands;
const kerkesatV2 = demandsV2;
---

<BaseLayout title={copy.meta.title} description={copy.meta.description} locale={locale}>
  <SiteFrame locale={locale} copy={siteCopyLocale} currentPage="protests" localePath="protestat">
    <main class="protests-page" id="main" tabindex="-1">
      <PageHero
        eyebrow={copy.hero.eyebrow}
        title={copy.hero.title}
        lead={copy.hero.lead}
        primaryCta={{ label: copy.hero.primaryCta, href: siteCopyLocale.hero.participateLink }}
        secondaryCta={{ label: copy.hero.secondaryCta, href: "/harta/" }}
        panelTitle={copy.hero.panelTitle}
        panelLinks={copy.hero.panelLinks}
      />
      
      <section class="section-block section-block--accent" id="specie">
        <div class="section-heading">
          <p class="eyebrow">{copy.speciesSection.kicker}</p>
          <h2>{copy.speciesSection.title}</h2>
          <p>{copy.speciesSection.description}</p>
        </div>

        <CardSlider items={speciesItems} ariaLabel={copy.speciesSection.title} cardWidth="min(80vw, 260px)" />
        <p class="media-credit">{copy.speciesCredit}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="https://ppnea.org/save-vjosa-narta/?lang=en" target="_blank" rel="noreferrer">
            {copy.speciesSection.sourceLabel}
          </a>
        </div>
      </section>

      <section class="section-block" id="arsyet-tjera">
        <div class="section-intro">
          <div class="section-heading">
            <p class="eyebrow">{copy.arsyetTjera.kicker}</p>
            <h2>{copy.arsyetTjera.title}</h2>
            <p>{copy.arsyetTjera.description}</p>
            <div class="hero__actions">
              <a class="button button--primary" href="/dosjet/">{copy.arsyetTjera.dossierLabel}</a>
            </div>
          </div>
          <SectionMedia src={copy.arsyetTjera.image.src} alt={copy.arsyetTjera.image.alt} />
        </div>

        <ul class="topics-grid">
          {copy.arsyetTjera.topics.map((topic) => <li class="topic-card">{topic}</li>)}
        </ul>
      </section>

      <section class="section-block section-block--accent" id="historiku">
        <div class="section-heading">
          <p class="eyebrow">{copy.historiku.kicker}</p>
          <h2>{copy.historiku.title}</h2>
          <p>{copy.historiku.description}</p>
        </div>

        <CardSlider items={historikuCards} ariaLabel={copy.historiku.title} cardWidth="min(82vw, 300px)" />
        <p class="media-credit">{copy.photoCredit}</p>
        <div class="hero__actions">
          <a class="button button--primary" href="/harta/">{copy.mapReferenceLabel}</a>
        </div>
      </section>

      <section class="section-block" id="kerkesat">
        <div class="section-heading">
          <p class="eyebrow">{copy.kerkesat.kicker}</p>
          <h2>{copy.kerkesat.title}</h2>
          <p>{copy.kerkesat.description}</p>
        </div>

        <details class="kerkesat-dropdown">
          <summary>
            <div>
              <h3><span class="kerkesat-dropdown__version">v1</span>{copy.kerkesat.versioni1Title}</h3>
              <p>{copy.kerkesat.versioni1Description}</p>
            </div>
            <span class="kerkesat-dropdown__chevron" aria-hidden="true" />
          </summary>
          <div class="kerkesat-dropdown__body">
            <ol class="demand-grid">
              {
                kerkesatV1.map((item, index) => (
                  <li class="demand-card">
                    <span class="demand-card__index">{String(index + 1).padStart(2, "0")}</span>
                    <p>{item}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </details>

        <details class="kerkesat-dropdown">
          <summary>
            <div>
              <h3><span class="kerkesat-dropdown__version">v2</span>{copy.kerkesat.versioni2Title}</h3>
              <p>{copy.kerkesat.versioni2Description}</p>
            </div>
            <span class="kerkesat-dropdown__chevron" aria-hidden="true" />
          </summary>
          <div class="kerkesat-dropdown__body">
            <ol class="demand-list">
              {
                kerkesatV2.map((item, index) => (
                  <li class="demand-block">
                    <span class="demand-block__index">{index + 1}</span>
                    <div class="demand-block__body">
                      <p>{item.text}</p>
                      {item.subitems && (
                        <ul class="demand-sublist">
                          {item.subitems.map((sub) => (
                            <li>{sub}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </li>
                ))
              }
            </ol>
          </div>
        </details>

        <div class="hero__actions">
          <a class="button button--primary" href={siteCopyLocale.hero.participateLink}>{siteCopyLocale.hero.primaryCta}</a>
        </div>
      </section>

      <section class="section-block section-block--accent" id="rrugedalja">
        <div class="section-heading">
          <p class="eyebrow">{copy.waySection.kicker}</p>
          <h2>{copy.waySection.title}</h2>
          <p>{copy.waySection.description}</p>
        </div>

        <ol class="way-list">
          {
            copy.wayCards.map((card, index) => (
              <li class="way-card">
                <span class="way-card__index">{index + 1}</span>
                <div class="way-card__body">
                  <h3>{card.title}</h3>
                  <p>{card.body}</p>
                  {card.href && (
                    <a class="info-card__link" href={card.href}>
                      {card.linkLabel ?? "Lexo më shumë"}
                    </a>
                  )}
                </div>
              </li>
            ))
          }
        </ol>

        <div class="hero__actions">
          <a class="button button--primary" href="/referendum/">{copy.waySection.referendumLabel}</a>
        </div>
      </section>
    </main>
  </SiteFrame>
</BaseLayout>

<style>
  .media-credit {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: 0.74rem;
    font-weight: 600;
    text-align: right;
  }

  .info-card__link {
    display: inline-block;
    margin-top: 0.7rem;
    color: var(--accent-strong);
    font-weight: 700;
    text-decoration: underline;
  }

  .info-card__link:hover,
  .info-card__link:focus-visible {
    color: var(--ink);
  }

  .topics-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 1.8rem;
    list-style: none;
    padding: 0;
  }

  .topic-card {
    padding: 0.9rem 1.1rem;
    border: 2px solid var(--ink);
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--ink);
    font-weight: 700;
    line-height: 1.4;
  }

  .topic-card:nth-child(3n+2) {
    background: var(--paper-cool);
    transform: rotate(0.6deg);
  }

  .topic-card:nth-child(3n) {
    background: var(--accent-soft);
    transform: rotate(-0.5deg);
  }

  @media (max-width: 1020px) {
    .topics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .topics-grid {
      grid-template-columns: 1fr;
    }
  }

  .kerkesat-dropdown {
    border: 2px solid var(--ink);
    background: var(--surface);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .kerkesat-dropdown + .kerkesat-dropdown {
    margin-top: 1.1rem;
  }

  .kerkesat-dropdown summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.4rem;
    cursor: pointer;
    list-style: none;
  }

  .kerkesat-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .kerkesat-dropdown summary h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 0.35rem;
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    line-height: 1.1;
  }

  .kerkesat-dropdown__version {
    flex-shrink: 0;
    padding: 0.15rem 0.55rem;
    border: 2px solid var(--ink);
    background: var(--accent-strong);
    color: var(--ink-reverse, #fff);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .kerkesat-dropdown summary p {
    margin: 0;
    color: var(--muted);
  }

  .kerkesat-dropdown__chevron {
    flex-shrink: 0;
    width: 0.7rem;
    height: 0.7rem;
    margin-right: 0.3rem;
    border-right: 2px solid var(--ink);
    border-bottom: 2px solid var(--ink);
    transform: rotate(45deg);
    transition: transform 150ms ease;
  }

  .kerkesat-dropdown[open] .kerkesat-dropdown__chevron {
    transform: rotate(-135deg);
  }

  .kerkesat-dropdown__body {
    padding: 0 1.4rem 1.4rem;
  }

  .demand-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .demand-card {
    position: relative;
    padding: 1.15rem;
    padding-top: 3rem;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .demand-card:nth-child(2) {
    background: var(--paper-cool);
    transform: rotate(0.75deg);
  }

  .demand-card:nth-child(3) {
    background: var(--accent-soft);
    transform: rotate(-0.65deg);
  }

  .demand-card:nth-child(5) {
    background: var(--paper-cool);
    transform: rotate(-0.5deg);
  }

  .demand-card__index {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    color: var(--accent-strong);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .demand-card p {
    margin: 0;
    font-weight: 700;
    line-height: 1.5;
  }

  .demand-list {
    display: grid;
    gap: 0.9rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .demand-block {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    padding: 1.15rem;
    border: 2px solid var(--ink);
    background: var(--paper);
    box-shadow: 4px 4px 0 var(--ink);
  }

  .demand-block__index {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 2px solid var(--ink);
    background: var(--ink);
    color: var(--ink-reverse);
    font-weight: 800;
    font-size: 0.95rem;
  }

  .demand-block__body p {
    margin: 0;
    font-weight: 700;
    line-height: 1.55;
  }

  .demand-sublist {
    display: grid;
    gap: 0.45rem;
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
    color: var(--muted);
    font-weight: 600;
    line-height: 1.55;
  }

  .way-list {
    display: grid;
    gap: 0.9rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .way-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.9rem;
    padding: 1.15rem;
    border: 2px solid var(--ink);
    background: var(--surface);
    box-shadow: 5px 5px 0 var(--ink);
  }

  .way-card__index {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 2px solid var(--ink);
    background: var(--accent-strong);
    color: var(--ink-reverse);
    font-weight: 800;
    font-size: 1.1rem;
  }

  .way-card__body h3 {
    margin: 0 0 0.4rem;
  }

  .way-card__body p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  @media (max-width: 1020px) {
    .demand-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .demand-block,
    .way-card {
      grid-template-columns: 1fr;
    }

    .demand-card {
      transform: none !important;
    }
  }
</style>
