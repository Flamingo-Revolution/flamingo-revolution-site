---
import BaseLayout from "./BaseLayout.astro";
import { siteCopy } from "../data/site";
import SiteFooter from "@components/SiteFooter.astro";
import type { BreadcrumbItem } from "../lib/seo/structuredData";

interface Props {
	title: string;
	description: string;
	socialImagePath?: string;
	socialImageAlt?: string;
	shellClass?: string;
	pageType?: "WebPage" | "Article";
	jsonLdExtra?: object[];
	breadcrumbs?: BreadcrumbItem[];
}

const {
	title,
	description,
	socialImagePath = "/referendum/flamingo-cover.png",
	socialImageAlt = "Flamingo Revolution — referendumi për Ligjin 21/2024",
	shellClass = "",
	pageType = "WebPage",
	jsonLdExtra,
	breadcrumbs
} = Astro.props;

const copy = siteCopy.sq;
---

<BaseLayout
	title={title}
	description={description}
	locale="sq"
	pageType={pageType}
	socialImagePath={socialImagePath}
	socialImageAlt={socialImageAlt}
	jsonLdExtra={jsonLdExtra}
	breadcrumbs={breadcrumbs}
>
	<div class:list={["page-shell", "referendum-shell", shellClass]}>
		<slot />
		<SiteFooter locale="sq" {copy} />
	</div>
</BaseLayout>
