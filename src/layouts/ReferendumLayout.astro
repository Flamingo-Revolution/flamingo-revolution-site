---
import BaseLayout from "./BaseLayout.astro";
import { siteCopy } from "../data/site";

interface Props {
	title: string;
	description: string;
	socialImagePath?: string;
	socialImageAlt?: string;
	shellClass?: string;
}

const {
	title,
	description,
	socialImagePath = "/referendum/flamingo-cover.png",
	socialImageAlt = "Flamingo Revolution — referendumi për Ligjin 21/2024",
	shellClass = ""
} = Astro.props;

const copy = siteCopy.sq;
---

<BaseLayout
	title={title}
	description={description}
	locale="sq"
	socialImagePath={socialImagePath}
	socialImageAlt={socialImageAlt}
>
	<div class:list={["page-shell", "referendum-shell", shellClass]}>
		<slot />
		<footer class="footer-note">
			<p>{copy.footer.text}</p>
			<nav class="footer-links" aria-label="Social links">
				{
					copy.footer.links.map((link) => (
						<a href={link.href} target="_blank" rel="noreferrer">
							{link.label}
						</a>
					))
				}
			</nav>
		</footer>
	</div>
</BaseLayout>
