generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum IdeaStatus {
  VISIBLE
  HIDDEN
}

enum VoteValue {
  UP
  DOWN
}

model Idea {
  id            String     @id @default(uuid())
  createdAt     DateTime   @default(now()) @map("created_at")
  content       String
  status        IdeaStatus @default(VISIBLE)
  submitterHash String     @map("submitter_hash")
  submitterName String?    @map("submitter_name")
  upvoteCount   Int        @default(0) @map("upvote_count")
  downvoteCount Int        @default(0) @map("downvote_count")
  score         Int        @default(0)
  votes         Vote[]

  @@index([status, score(sort: Desc), createdAt(sort: Desc)])
  @@map("ideas")
}

model Vote {
  id        String    @id @default(uuid())
  ideaId    String    @map("idea_id")
  idea      Idea      @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  voterHash String    @map("voter_hash")
  value     VoteValue
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([ideaId, voterHash])
  @@index([voterHash])
  @@map("votes")
}

model NewsletterSignup {
  id        String   @id @default(uuid())
  email     String
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, reason])
  @@map("newsletter_signups")
}

enum ReporterStatus {
  ACTIVE
  DISABLED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Reporter {
  id        String            @id @default(uuid())
  createdAt DateTime          @default(now()) @map("created_at")
  name      String
  slug      String            @unique
  keyHash   String            @unique @map("key_hash")
  status    ReporterStatus    @default(ACTIVE)
  sessions  ReporterSession[]
  articles  Article[]

  @@map("reporters")
}

model ReporterSession {
  id         String   @id @default(uuid())
  tokenHash  String   @unique @map("token_hash")
  reporterId String   @map("reporter_id")
  reporter   Reporter @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([reporterId])
  @@map("reporter_sessions")
}

model Article {
  id            String        @id @default(uuid())
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  publishedAt   DateTime?     @map("published_at")
  title         String        @default("")
  slug          String?       @unique
  excerpt       String        @default("")
  tags          String[]      @default([])
  coverImageUrl String?       @map("cover_image_url")
  content       Json          @default("{}")
  status        ArticleStatus @default(DRAFT)
  reporterId    String        @map("reporter_id")
  reporter      Reporter      @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, publishedAt(sort: Desc)])
  @@index([reporterId, updatedAt(sort: Desc)])
  @@map("articles")
}
