# Database
# --------------------------------
POSTGRES_DB="db"
POSTGRES_USER="user"
POSTGRES_PASSWORD="..."

# Prisma CLI (migrate, studio) — Neon DIRECT connection (no -pooler)
DIRECT_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@url/${POSTGRES_DB}?sslmode=require&channel_binding=require"

# Neon pooled connection — Pages Functions (wrangler pages dev + Cloudflare Pages)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@url/${POSTGRES_DB}?sslmode=require&channel_binding=require"

# Google Apps Script ideas feed (temporary until DB-backed API)
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# --- Analytics ---
PUBLIC_UMAMI_SCRIPT="https://cloud.umami.is/script.js"
PUBLIC_UMAMI_DATA_WEBSITE_ID="..."
