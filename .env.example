# Database
# --------------------------------
POSTGRES_DB="db"
POSTGRES_USER="user"
POSTGRES_PASSWORD="..."

# Prisma CLI (migrate, studio) — Neon DIRECT connection (no -pooler)
DIRECT_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@url/${POSTGRES_DB}?sslmode=require&channel_binding=require"

# Neon pooled connection — Pages Functions (wrangler pages dev + Cloudflare Pages)
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@url/${POSTGRES_DB}?sslmode=require&channel_binding=require"

# Discord notification for newly submitted ideas (server-side secret)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Google Apps Script ideas feed (temporary until DB-backed API)
APPS_SCRIPT_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# --- Analytics ---
PUBLIC_UMAMI_SCRIPT="https://cloud.umami.is/script.js"
PUBLIC_UMAMI_DATA_WEBSITE_ID="..."

# Flamingo Bot (optional override; the component uses this production origin by default)
# Local development may use http://localhost:8000. Other environments require HTTPS.
PUBLIC_FLAMINGO_BOT_URL="https://flamingo-bot-949711463853.europe-west3.run.app"

# Zogjtë e Axhituar leaderboard (public browser credentials; used at build time)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
